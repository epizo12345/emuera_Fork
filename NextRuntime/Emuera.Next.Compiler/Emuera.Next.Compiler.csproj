<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Minimum</AnalysisMode>
    <EnablePerformanceMetrics Condition="'$(EnablePerformanceMetrics)' == ''">false</EnablePerformanceMetrics>
    <DefineConstants Condition="'$(EnablePerformanceMetrics)' == 'true'">$(DefineConstants);PERFORMANCE_METRICS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Emuera.Next.Core\Emuera.Next.Core.csproj" />
  </ItemGroup>
</Project>
