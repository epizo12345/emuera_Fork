    async Task StartP1C1(string query)
    {
        string profile = QueryValue(query, "profile") ?? "default";
        if (profile.Length is < 1 or > 64 || profile.Any(character => !char.IsAsciiLetterOrDigit(character) && character is not '.' and not '_' and not '-'))
            throw new InvalidDataException("profileIdが不正です");
        string fixtureCase = QueryValue(query, "case") ?? "default";
        string fault = QueryValue(query, "fault") ?? string.Empty;
        importMode = QueryValue(query, "import") == "1";
        SetDiagnosticStage("js-module-import-start");
        storeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./global-persistence.js");
        SetDiagnosticStage("js-module-import-end");
        string gameId = isP1C1Real ? "shin-era-tensei-p" : "p1c1-fixture";
        SetDiagnosticStage("web-lock-acquire-start");
        StoreLockResult lockResult = await storeModule.InvokeAsync<StoreLockResult>("acquire", gameId, profile);
        SetDiagnosticStage("web-lock-acquire-end");
        if (!lockResult.Acquired || string.IsNullOrEmpty(lockResult.HandleId))
        {
            persistenceState = "lock-failed";
            error = lockResult.Reason ?? "この保存領域は別タブで使用中です";
            return;
        }
        storeHandle = lockResult.HandleId;
        SetDiagnosticStage("indexeddb-prepare-start");
        StorePrepareResult prepared = await storeModule.InvokeAsync<StorePrepareResult>("prepare", storeHandle, fault);
        SetDiagnosticStage("indexeddb-prepare-end");
        loadSource = prepared.Exists ? "indexeddb" : "absent";
        revision = prepared.Revision ?? string.Empty;

        p1c1Root = (isP1C1Real ? "/p1c1-real-runtime-" : "/p1c1-runtime-") + profile;
        SetDiagnosticStage("run-root-assigned");
        SetDiagnosticStage("data-prepare-start");
        await PrepareP1C1Data(p1c1Root, isP1C1Real, fixtureCase);
        SetDiagnosticStage("data-prepare-end");

        if (importMode)
        {
            if (prepared.Exists)
            {
                persistenceState = "import-refused";
                error = "既存profileにはimportしません。新しいprofileIdを指定してください";
                return;
            }
            progress = "global.savを選択してください";
            importFormReady = true;
            SetDiagnosticStage("import-form-ready");
            return;
        }

        progress = isP1C1Real ? "実GLOBAL codec診断中です…" : "GLOBAL Runtimeを実行中です…";
        SetDiagnosticStage("runtime-bootstrap-start");
        session = isP1C1Real
            ? await BrowserRuntimeSession.StartPersistentBootstrapAsync(p1c1Root, prepared.Bytes)
            : await BrowserRuntimeSession.StartPersistentAsync(p1c1Root, prepared.Bytes);
        SetDiagnosticStage("runtime-bootstrap-end");
        if (isP1C1Real)
        {
            SetDiagnosticStage("loadglobal-diagnostic-start");
            GlobalCodecDiagnosticResult diagnostic = session.RunGlobalCodecDiagnostic(resave: false);
            SetDiagnosticStage("loadglobal-diagnostic-end");
            inputSha256 = diagnostic.InputSha256;
            codecValueSha256 = diagnostic.ValueSha256;
            if (!diagnostic.LoadSucceeded)
            {
                persistenceState = "validation-failed";
                error = "既存LoadGlobalが実GLOBALを拒否しました";
                return;
            }
        }
        if (session.Status == BrowserRuntimeStatus.Persisting)
        {
            persistenceState = "persisting";
            try
            {
                await session.DrainPersistenceAsync(async request =>
                {
                    SetDiagnosticStage("indexeddb-commit-start");
                    StoreCommitResult committed = await CommitMutation(request, fault);
                    SetDiagnosticStage("indexeddb-commit-end");
                    revision = committed.Revision;
                    durability = committed.Durability;
                    persistenceState = "committed";
                });
            }
            catch (Exception ex)
            {
                persistenceState = "failed";
                error = session.PersistenceError ?? ex.Message;
                progress = "GLOBAL永続保存に失敗しました";
                return;
            }
        }
        p1c1Ready = isP1C1Real
            ? session.Status == BrowserRuntimeStatus.BootstrapReady && session.DoScriptCallCount == 0
            : session.Status == BrowserRuntimeStatus.Succeeded;
        progress = p1c1Ready ? (isP1C1Real ? "実GLOBAL codec診断完了（タイトル未実行）" : "GLOBAL Runtime完了") : $"GLOBAL Runtime停止: {session.Status}";
    }

    async Task StartP1C2(string query)
    {
        string profile = QueryValue(query, "profile") ?? "default";
        if (profile.Length is < 1 or > 64 || profile.Any(character => !char.IsAsciiLetterOrDigit(character) && character is not '.' and not '_' and not '-'))
            throw new InvalidDataException("profileIdが不正です");
        importMode = QueryValue(query, "import") == "1";
        diagnosticContinuation = QueryValue(query, "diagnosticContinuation") == "1";
        SetDiagnosticStage("js-module-import-start");
        storeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./global-persistence.js");
        longRunningModule = await JS.InvokeAsync<IJSInProcessObjectReference>("import", "./long-running-prompt.js");
        SetDiagnosticStage("js-module-import-end");
        SetDiagnosticStage("web-lock-acquire-start");
        StoreLockResult lockResult = await storeModule.InvokeAsync<StoreLockResult>("acquire", "shin-era-tensei-p", profile);
        SetDiagnosticStage("web-lock-acquire-end");
        if (!lockResult.Acquired || string.IsNullOrEmpty(lockResult.HandleId))
            throw new InvalidOperationException(lockResult.Reason ?? "この保存領域は別タブで使用中です");
        storeHandle = lockResult.HandleId;
        SetDiagnosticStage("indexeddb-prepare-start");
        StorePrepareResult prepared = await storeModule.InvokeAsync<StorePrepareResult>("prepare", storeHandle, string.Empty);
        SetDiagnosticStage("indexeddb-prepare-end");
        loadSource = prepared.Exists ? "indexeddb" : "absent";
        revision = prepared.Revision ?? string.Empty;
        p1c1Root = "/p1c2-runtime-" + profile;
        SetDiagnosticStage("data-prepare-start");
        await PrepareP1C1Data(p1c1Root, real: true, fixtureCase: "default");
        SetDiagnosticStage("data-prepare-end");
        dataReady = true;

        if (importMode)
        {
            if (prepared.Exists)
                throw new InvalidOperationException("既存profileにはimportしません。新しいprofileIdを指定してください");
            importFormReady = true;
            progress = "実データ準備完了。global.savを選択してください";
            SetDiagnosticStage("import-form-ready");
            return;
        }
        await StartP1C2Title(prepared.Bytes);
    }

    async Task StartP1C3(string query)
    {
        saveManagerMode = QueryValue(query, "saveManager") == "1";
        saveImportHandoffPending = QueryValue(query, "saveImportDone") == "1" && !saveManagerMode;
        saveImportCancellationHandoffPending = QueryValue(query, "saveImportCancelled") == "1" && !saveManagerMode;
        saveImportTitlePending = saveImportHandoffPending || saveImportCancellationHandoffPending;
        await SetHostStatusAsync("起動中：保存領域を確認しています…");
        string profile = QueryValue(query, "profile") ?? "default";
        if (profile.Length is < 1 or > 64 || profile.Any(character => !char.IsAsciiLetterOrDigit(character) && character is not '.' and not '_' and not '-'))
            throw new InvalidDataException("profileIdが不正です");
        importMode = QueryValue(query, "import") == "1";
        saveImportReadProbe = QueryValue(query, "saveImportProbe") == "1";
        pendingStagedImportNonce = QueryValue(query, "stagedImport");
        diagnosticContinuation = false;
        SetDiagnosticStage("js-module-import-start");
        storeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./global-persistence.js");
        if (!saveManagerMode)
            longRunningModule = await JS.InvokeAsync<IJSInProcessObjectReference>("import", "./long-running-prompt.js");
        if (startupImportProfileEnabled)
        {
            var profileModuleImport = System.Diagnostics.Stopwatch.StartNew();
            try
            {
                startupImportProfileModule = await JS.InvokeAsync<IJSObjectReference>("import", "./startup-import-profile.js");
                string profilePage = saveManagerMode
                    ? pendingStagedImportNonce is null ? "save-manager" : "save-manager-staged-import"
                    : saveImportTitlePending ? "title-after-import" : "normal-startup";
                await startupImportProfileModule.InvokeVoidAsync("beginStartupProfilePage", profilePage, new
                {
                    gameId = "shin-era-tensei-p",
                    profileId = profile,
                    appPath = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath,
                    candidateLabel = QueryValue(query, "startupProfileLabel")
                });
                await RecordStartupProfilePhaseAsync("profile-module-load-and-page-start", profileModuleImport, classification: "instrumentation");
            }
            catch (Exception ex)
            {
                startupImportProfileWarning = ex.GetType().Name;
                startupImportProfileModule = null;
            }
        }
        SetDiagnosticStage("js-module-import-end");
        SetDiagnosticStage("web-lock-acquire-start");
        var lockAcquireTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
        StoreLockResult lockResult = await storeModule.InvokeAsync<StoreLockResult>("acquire", "shin-era-tensei-p", profile);
        await RecordStartupProfilePhaseAsync("web-lock-acquire", lockAcquireTimer, new { acquired = lockResult.Acquired });
        SetDiagnosticStage("web-lock-acquire-end");
        if (!lockResult.Acquired || string.IsNullOrEmpty(lockResult.HandleId))
            throw new InvalidOperationException(lockResult.Reason ?? "この保存領域は別タブで使用中です");
        storeHandle = lockResult.HandleId;
        SetDiagnosticStage("indexeddb-prepare-start");
        var prepareTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
        StorePreparedFilesResult prepared = await storeModule.InvokeAsync<StorePreparedFilesResult>("prepareFiles", storeHandle, string.Empty);
        await RecordStartupProfilePhaseAsync("indexeddb-prepare-and-existing-save-read", prepareTimer, new
        {
            count = prepared.Files.Count(file => !file.Deleted),
            bytes = prepared.Files.Where(file => !file.Deleted).Sum(file => (long)(file.Bytes?.Length ?? 0))
        });
        SetDiagnosticStage("indexeddb-prepare-end");
        persistedFiles.Clear();
        persistedFiles.AddRange(prepared.Files);
        loadSource = persistedFiles.Any(file => !file.Deleted) ? "indexeddb" : "absent";
        p1c1Root = "/p1c3-runtime-" + profile;
        importFormReady = true;
        if (saveManagerMode)
        {
            if (QueryValue(query, "saveImportDone") == "1")
                saveManagementMessage = "保存ファイルを取り込みました。タイトルのLOAD GAMEから選択できます。";
            await SetHostStatusAsync(pendingStagedImportNonce is null ? string.Empty : "セーブ取込中：ファイルを確認しています…",
                busy: pendingStagedImportNonce is not null);
            progress = "保存済みセーブの一覧を表示しています";
            SetDiagnosticStage("save-manager-ready");
            await SaveStartupProfilePageSummaryAsync();
            return;
        }
        if (saveImportHandoffPending)
        {
            saveManagementMessage = "保存ファイルを取り込みました。タイトルのLOAD GAMEから選択してください。";
            await SetHostStatusAsync("取込完了：ゲームを起動しています…");
        }
        else if (saveImportCancellationHandoffPending)
        {
            saveManagementMessage = "上書き確認をキャンセルしました。既存の保存データを維持してタイトルへ戻ります。";
            await SetHostStatusAsync("取込をキャンセルしました。タイトルを起動しています…");
        }
        await SetHostStatusAsync("起動中：ゲームデータを準備しています…");
        SetDiagnosticStage("data-prepare-start");
        var packagePrepareTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
        await PrepareP1C1Data(p1c1Root, real: true, fixtureCase: "default");
        await RecordStartupProfilePhaseAsync("package-data-preparation-inclusive", packagePrepareTimer, new
        {
            packageCacheState,
            packageCacheHits,
            packageCacheMisses,
            httpRequests,
            transferBytes,
            extractMilliseconds,
            extractedBytes,
            packageFiles,
            packageLookups
        }, "inclusive");
        SetDiagnosticStage("data-prepare-end");
        dataReady = true;
        await SaveStartupProfilePageSummaryAsync();
        await StartP1C3Title(CurrentSaveFiles());
    }

    async Task StartP1C3Integration(string query)
    {
        string profile = QueryValue(query, "profile") ?? "default";
        if (profile.Length is < 1 or > 64 || profile.Any(character => !char.IsAsciiLetterOrDigit(character) && character is not '.' and not '_' and not '-'))
            throw new InvalidDataException("profileIdが不正です");
        integrationAction = QueryValue(query, "action") ?? "restore";
        if (integrationAction is not ("seed" or "restore" or "mutate" or "recreate"))
            throw new InvalidDataException("integration actionが不正です");
        if (!int.TryParse(QueryValue(query, "count") ?? "244", out integrationCount) || integrationCount is not (65 or 244))
            throw new InvalidDataException("integration countは65または244です");
        importMode = QueryValue(query, "import") == "1";
        diagnosticContinuation = false;
        SetDiagnosticStage("js-module-import-start");
        storeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./global-persistence.js");
        longRunningModule = await JS.InvokeAsync<IJSInProcessObjectReference>("import", "./long-running-prompt.js");
        SetDiagnosticStage("js-module-import-end");
        SetDiagnosticStage("web-lock-acquire-start");
        StoreLockResult lockResult = await storeModule.InvokeAsync<StoreLockResult>("acquire", "p1c3-r1-integration", profile);
        SetDiagnosticStage("web-lock-acquire-end");
        if (!lockResult.Acquired || string.IsNullOrEmpty(lockResult.HandleId))
            throw new InvalidOperationException(lockResult.Reason ?? "この保存領域は別タブで使用中です");
        storeHandle = lockResult.HandleId;
        SetDiagnosticStage("indexeddb-prepare-start");
        StorePreparedFilesResult prepared = await storeModule.InvokeAsync<StorePreparedFilesResult>("prepareFiles", storeHandle, string.Empty);
        SetDiagnosticStage("indexeddb-prepare-end");
        persistedFiles.Clear();
        persistedFiles.AddRange(prepared.Files);
        loadSource = persistedFiles.Any(file => !file.Deleted) ? "indexeddb" : "absent";
        p1c1Root = "/p1c3-r1-runtime-" + profile;
        SetDiagnosticStage("data-prepare-start");
        await PrepareP1C3IntegrationData(integrationAction, integrationCount);
        SetDiagnosticStage("data-prepare-end");
        dataReady = true;
        if (importMode)
        {
            importFormReady = true;
            progress = "P1C3-R1 import fixture ready";
            SetDiagnosticStage("integration-import-form-ready");
            return;
        }
        await StartP1C3Title(CurrentSaveFiles());
    }

    async Task StartP1C4Twait(string query)
    {
        string profile = QueryValue(query, "profile") ?? "default";
        string fixtureCase = QueryValue(query, "case") ?? "tw01";
        p1c5PersistenceFault = isP1C5 ? QueryValue(query, "fault") ?? string.Empty : string.Empty;
        if ((isP1C5 || isP1C6) && (!int.TryParse(QueryValue(query, "commitDelay") ?? "0", out p1c5CommitDelayMilliseconds)
            || p1c5CommitDelayMilliseconds is < 0 or > 2000))
            throw new InvalidDataException("P1C5 commitDelayが不正です");
        if (isP1C5 && (!int.TryParse(QueryValue(query, "skipBatch") ?? "16", out p1c5SkipBatchSize)
            || p1c5SkipBatchSize is < 1 or > 16))
            throw new InvalidDataException("P1C5 skipBatchが不正です");
        if (profile.Length is < 1 or > 64 || profile.Any(character => !char.IsAsciiLetterOrDigit(character) && character is not '.' and not '_' and not '-'))
            throw new InvalidDataException("profileIdが不正です");
        if (fixtureCase is not ("tw01" or "tw02" or "tw03" or "tw04" or "reject" or "reject-animation"
            or "layout-short" or "layout-long" or "layout-commands" or "layout-detail"
            or "p5-s01" or "p5-s02" or "p5-s03" or "p5-s04" or "p5-s05" or "p5-window" or "p5-input-skip" or "p5-primitive"
            or "p5-r1-messkip" or "p5-r1-button" or "p5-r1-toneinputs" or "historical-button"
            or "p6-main" or "p6-repeat" or "p6-force" or "p6-primitive" or "p6-native" or "p6-twait" or "p6-toneinputs" or "p6-save" or "p6-stop"
            or "r3r2-shop" or "r3r2-keypad" or "r3r2-background" or "r3r2-timed" or "r3r2-daimaq" or "r3r2-pos"))
            throw new InvalidDataException("P1C4 TWAIT fixture caseが不正です");
        storeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./global-persistence.js");
        longRunningModule = await JS.InvokeAsync<IJSInProcessObjectReference>("import", "./long-running-prompt.js");
        string fixtureGameId = isP1C6 ? "p1c6-macro" : isP1C5 ? "p1c5-skip" : "p1c4-twait";
        StoreLockResult lockResult = await storeModule.InvokeAsync<StoreLockResult>("acquire", fixtureGameId, profile);
        if (!lockResult.Acquired || string.IsNullOrEmpty(lockResult.HandleId))
            throw new InvalidOperationException(lockResult.Reason ?? "この保存領域は別タブで使用中です");
        storeHandle = lockResult.HandleId;
        StorePreparedFilesResult prepared = await storeModule.InvokeAsync<StorePreparedFilesResult>("prepareFiles", storeHandle, string.Empty);
        persistedFiles.Clear();
        persistedFiles.AddRange(prepared.Files);
        p1c1Root = (isP1C6 ? "/p1c6-macro-runtime-" : isP1C5 ? "/p1c5-skip-runtime-" : "/p1c4-twait-runtime-") + profile;
        await PrepareP1C4TwaitData(fixtureCase);
        dataReady = true;
        SetDiagnosticStage("p1c4-twait-start");
        await StartP1C3Title(CurrentSaveFiles());
    }

