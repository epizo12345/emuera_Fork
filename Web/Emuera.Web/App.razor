    protected override async Task OnInitializedAsync()
    {
        try
        {
            string query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
            startupImportProfileEnabled = QueryValue(query, "startupImportProfile") == "1";
            dataPrepBreakdownEnabled = startupImportProfileEnabled && QueryValue(query, "dataPrepBreakdown") == "1";
            warmStartupProfile = QueryValue(query, "warmStartupProfile") == "1" || startupImportProfileEnabled;
            string? requestedErbProfileMode = QueryValue(query, "erbProfile");
            erbExecutionProfile = requestedErbProfileMode is not null && BrowserRuntimeSession.SupportsErbExecutionProfiler;
#if ERB_EXECUTION_PROFILE
            erbProfileMode = requestedErbProfileMode == "1" ? "full" : requestedErbProfileMode;
            if (erbExecutionProfile && erbProfileMode is not ("off" or "functions" or "full"))
                throw new InvalidDataException("erbProfile must be off, functions, or full");
            erbProfileMacro = erbExecutionProfile ? QueryValue(query, "erbProfileMacro") : null;
            erbProfileStartAt = erbExecutionProfile ? QueryValue(query, "erbProfileStartAt") : null;
            erbProfileSelfCheck = QueryValue(query, "erbProfileSelfCheck") == "1";
#endif
            captureR3R3RawHtml = QueryValue(query, "r3r3CaptureRawHtml") == "1";
            string key = FixtureKey(query);
            perfGate01b = QueryValue(query, "perfGate01b") == "1";
            perfGate01c = QueryValue(query, "perfGate01c") == "1";
            diagnosticOutput = QueryValue(query, "diagnosticOutput") == "1";
            domWindowMode = QueryValue(query, "domWindowMode") ?? "window";
            isP1C3Integration = key == "p1c3-r1";
            isP1C5 = key == "p1c5-skip" || (key == "p1c3-real" && QueryValue(query, "p1c5") == "1");
            isP1C6 = key == "p1c6-macro";
            isP1C4Small = key is "p1c4-twait" or "p1c5-skip" or "p1c6-macro";
            isP1C3 = key is "p1c3-real" or "p1c3-r1" or "p1c4-twait" or "p1c5-skip" or "p1c6-macro";
            isP1C4Real = key == "p1c3-real" && QueryValue(query, "p1c4") == "1";
            isP1C4State = key == "p1c3-real" && QueryValue(query, "p1c4state") == "1";
            isP1C2 = isP1C3 || key is "p1c2-real" or "p1c2-host";
            if (isP1C2)
            {
                SetDiagnosticStage("component-start");
                if (isP1C4Small) await StartP1C4Twait(query);
                else if (isP1C3Integration) await StartP1C3Integration(query);
                else if (isP1C3) await StartP1C3(query);
                else if (key == "p1c2-host") await StartP1C2Host(query);
                else await StartP1C2(query);
                return;
            }
            isP1C1Real = key == "p1c1-real";
            isP1C1 = key is "p1c1" or "p1c1-real";
            if (isP1C1)
            {
                SetDiagnosticStage("component-start");
                await StartP1C1(query);
                return;
            }
            isP1B = key == "p1b";
            if (isP1B)
            {
                await StartP1B();
                return;
            }
            string sourceRoot = key switch
            {
                "main" => "p1a-fixture",
                "r2" => "p1a-r2-fixture",
                _ => "p1a-r1-guards/" + key
            };
            string root = "/p1a-runtime-fixture-" + key;
            string[] files = key switch
            {
                "main" => ["CSV/GAMEBASE.CSV", "ERB/P1A.ERH", "ERB/P1A.ERB"],
                "r2" => ["CSV/GAMEBASE.CSV", "ERB/P1A_R2.ERH", "ERB/P1A_R2.ERB"],
                _ => ["CSV/GAMEBASE.CSV", "ERB/P1A.ERB"]
            };
            foreach (string relative in files)
            {
                string destination = Path.Combine(root, relative.Replace('/', Path.DirectorySeparatorChar));
                Directory.CreateDirectory(Path.GetDirectoryName(destination)!);
                File.WriteAllBytes(destination, await Http.GetByteArrayAsync(sourceRoot + "/" + relative));
            }
            session = await BrowserRuntimeSession.StartAsync(root);
        }
        catch (Exception ex)
        {
            if (isP1C1)
                SetDiagnosticStage("component-error");
            if (isP1C3)
            {
                startupErrorDetails = ex.ToString();
                if (saveImportTitlePending)
                {
                    bool wasCancellationHandoff = saveImportCancellationHandoffPending;
                    if (wasCancellationHandoff)
                    {
                        error = "セーブ取込はキャンセル済みですが、タイトル起動に失敗しました。既存の保存データは変更していません。";
                        saveManagementMessage = "取込はキャンセル済みです。既存セーブは維持されています。タイトル起動のみ失敗しました。";
                    }
                    else
                    {
                        error = "セーブ取込は完了しましたが、ゲーム起動に失敗しました。保存済みデータは残っています。再取込せず、詳細を確認してください。";
                        saveManagementMessage = "セーブの保存は完了しています。タイトル起動のみ失敗しました。取込を再実行しないでください。";
                    }
                    saveImportTitlePending = false;
                    ClearSaveImportHandoff();
                    await SetHostStatusAsync(wasCancellationHandoff
                        ? "取込はキャンセル済みですが、タイトル起動に失敗しました。"
                        : "セーブ取込は完了しましたが、ゲーム起動に失敗しました。", busy: false, isError: true);
                }
                else
                {
                    error = "起動を続けられませんでした。詳細は「起動診断情報」を確認してください。";
                    await SetHostStatusAsync("起動できませんでした。画面の実行診断を確認してください。", busy: false, isError: true);
                }
            }
            else
                error = ex.ToString();
            if (startupImportProfileEnabled && !p1c2Ready)
                await FinishStartupImportProfileAsync("startup-failed");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (session is { PendingAwait: { } hostAwait } awaitingSession
            && (!ReferenceEquals(scheduledAwaitSession, awaitingSession) || scheduledAwaitRequestId != hostAwait.RequestId))
        {
            awaitTimer?.Cancel();
            awaitTimer?.Dispose();
            awaitTimer = new CancellationTokenSource();
            scheduledAwaitSession = awaitingSession;
            scheduledAwaitRequestId = hostAwait.RequestId;
            _ = CompleteHostAwaitAsync(awaitingSession, hostAwait, awaitTimer.Token, macroOperationId);
        }
        if (isP1C3 && !scaleFitAttached)
        {
            scaleFitModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./scale-fit.js");
            await scaleFitModule.InvokeVoidAsync("attach");
            scaleFitAttached = true;
        }
#if ERB_EXECUTION_PROFILE
        TraceGameplayStage("after-render-begin");
#endif
        if (isP1C2 && storeModule is not null && storeHandle is not null && !keyMacrosLoaded)
        {
            try
            {
                var saved = await storeModule.InvokeAsync<KeyMacroSettings>("loadKeyMacros", storeHandle);
                keyMacros.Restore(saved.Group, saved.Slots, saved.GroupNames);
                keyMacroMessage = saved.Message;
            }
            catch (Exception ex) { keyMacroMessage = "設定を読めません。このページ内でのみ使用します: " + ex.Message; }
            keyMacrosLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
        if (isP1C2 && storeModule is not null && !keyMacrosAttached)
        {
            displayWindowReference ??= DotNetObjectReference.Create(this);
            keyMacroModule = await JS.InvokeAsync<IJSObjectReference>("import", "./host-key-macros.js");
            await keyMacroModule.InvokeVoidAsync("attach", displayWindowReference);
            keyMacrosAttached = true;
        }
        if (isP1C2 && storeModule is not null && !inputGuardAttached)
        {
            displayWindowReference ??= DotNetObjectReference.Create(this);
            await storeModule.InvokeVoidAsync("installOneInputGuard", "game-screen", displayWindowReference);
            await storeModule.InvokeVoidAsync("installAbsoluteViewport", "game-screen");
            inputGuardAttached = true;
        }
        if (isP1C2 && storeModule is not null && session is { IslandLineCount: > 0 } && !islandInputGuardAttached)
        {
            await storeModule.InvokeVoidAsync("installOneInputGuard", "game-island-layer");
            islandInputGuardAttached = true;
        }
        else if (session is not { IslandLineCount: > 0 }) islandInputGuardAttached = false;
        if (isP1C2 && session is not null && !tooltipAttached)
        {
            tooltipModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./game-tooltip.js");
            await tooltipModule.InvokeVoidAsync("attach", "game-surface");
            tooltipAttached = true;
        }
        if (saveManagerMode && importFormReady && !stagedImportApplied && pendingStagedImportNonce is not null
            && storeModule is not null && storeHandle is not null)
        {
            stagedImportApplied = true;
            var stagedImportApply = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            try { await storeModule.InvokeAsync<int>("applyStagedImport", storeHandle, pendingStagedImportNonce, "p1c3-import"); }
            catch (Exception ex)
            {
                await RecordStartupProfilePhaseAsync("cache-staged-import-apply", stagedImportApply, new { outcome = "failed" });
                persistenceState = "validation-refused";
                saveManagementMessage = "取込準備に失敗しました: " + ex.Message;
                await SetHostStatusAsync("セーブ取込を開始できませんでした。既存の保存済みデータは変更されていません。", busy: false, isError: true);
                try { await storeModule.InvokeVoidAsync("clearStagedImport", pendingStagedImportNonce); }
                catch (Exception clearError) { saveManagementMessage += " 一時データを消去できません: " + clearError.Message; }
                await FinishStartupImportProfileAsync("staged-import-apply-failed");
                await InvokeAsync(StateHasChanged);
            }
            if (stagedImportApply?.IsRunning == true)
                await RecordStartupProfilePhaseAsync("cache-staged-import-apply", stagedImportApply, new { outcome = "completed" });
        }
        if (session?.PendingInput is { TimedInputName: "TWAIT" or "TINPUT" or "TINPUTS" or "TONEINPUT" or "TONEINPUTS", TimeLimit: > 0 } prompt
            && (!session.MessageSkip.Active || (prompt.Kind == BrowserInputKind.TimedVoid && !AllowMacroForcedWait))
            && scheduledTwaitRequestId != prompt.RequestId)
            ScheduleTwaitTimeout(prompt);
        if (session?.PendingInput is { Kind: BrowserInputKind.Integer or BrowserInputKind.String, TimeLimit: > 0, DisplayTime: true } timedPrompt
            && scheduledCountdownRequestId != timedPrompt.RequestId)
        {
            timedInputDisplayModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./timed-input-display.js");
            await timedInputDisplayModule.InvokeVoidAsync("start", timedPrompt.RequestId, timedPrompt.TimeLimit);
            scheduledCountdownRequestId = timedPrompt.RequestId;
        }
        if (session?.PendingInput is { } focusPrompt && storeModule is not null
            && (focusSessionGeneration != session.SessionGeneration || focusRequestId != focusPrompt.RequestId))
        {
            string? target = focusPrompt is { Kind: BrowserInputKind.String or BrowserInputKind.Integer, OneInput: true }
                ? "game-screen"
                : focusPrompt.Kind is BrowserInputKind.Integer or BrowserInputKind.String
                ? "runtime-input"
                : focusPrompt.Kind is BrowserInputKind.Enter or BrowserInputKind.AnyKey or BrowserInputKind.MouseKey ? "game-screen" : null;
            if (target is not null)
            {
                focusSessionGeneration = session.SessionGeneration;
                focusRequestId = focusPrompt.RequestId;
                if (target == "runtime-input"
                    || (focusPrompt.Kind == BrowserInputKind.String && focusPrompt.OneInput
                        && focusPrompt.TimeLimit <= 0 && string.IsNullOrEmpty(focusPrompt.TimedInputName)))
                    await storeModule.InvokeVoidAsync("installInputCompositionGuard", "runtime-input");
                await storeModule.InvokeVoidAsync("focusElement", target);
            }
        }
        if (IsDisplayWindowMode && session is not null)
        {
            await UpdateDisplayWindowAsync();
        }
        if (isP1C2 && storeModule is not null)
            await storeModule.InvokeVoidAsync("positionLockedButtons", "game-screen");
        if (IsDisplayWindowMode && displayWindowModule is not null
            && session?.PendingInput is { Kind: BrowserInputKind.String, OneInput: true, TimeLimit: <= 0, TimedInputName: null or "" } movementPrompt)
            await displayWindowModule.InvokeVoidAsync("oneInputPresentation", session.SessionGeneration, movementPrompt.RequestId, true);
#if ERB_EXECUTION_PROFILE
        TraceGameplayStage("after-render-end");
        if (erbProfileSelfCheck && !erbProfileSelfCheckCompleted)
        {
            erbProfileSelfCheckCompleted = true;
            await JS.InvokeVoidAsync("console.info", "WEB_ERB_EXECUTION_PROFILE_CHECK", BrowserRuntimeSession.RunErbExecutionProfilerSelfCheck());
        }
        if (erbExecutionProfile && isP1C4Real && !erbProfileMacroStarted
            && !string.IsNullOrWhiteSpace(erbProfileMacro) && !string.IsNullOrWhiteSpace(erbProfileStartAt)
            && session?.PendingInput is { Kind: BrowserInputKind.String, OneInput: true }
            && session.CurrentErbPosition.Contains(erbProfileStartAt, StringComparison.Ordinal))
        {
            erbProfileMacroStarted = true;
            await SubmitP1C2Macro(erbProfileMacro);
        }
#endif
        if (startupImportProfileEnabled && !startupImportProfileFinished && p1c2Ready && startupImportProfileModule is not null)
            await CompleteStartupImportProfileAsync();
    }

    async Task UpdateDisplayWindowAsync()
    {
        if (session is null) return;
        if (!ReferenceEquals(displayWindowSession, session))
        {
            if (displayWindowAttached && displayWindowModule is not null)
                await displayWindowModule.InvokeVoidAsync("detach", "game-screen");
            displayWindow.Reset();
            displayWindowSession = session;
            displayWindowAttached = false;
            displayWindowCorrectionCount = 0;
            lastCurrentDisplayLineId = 0;
            lastMeasuredCurrentLineId = 0;
            lastMeasuredCurrentDisplayGeneration = -1;
        }
        displayWindowModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./display-window.js");
        displayWindowReference ??= DotNetObjectReference.Create(this);
        if (!displayWindowAttached)
        {
            await displayWindowModule.InvokeVoidAsync("attach", "game-screen", displayWindowReference);
            displayWindowAttached = true;
        }

        IReadOnlyList<BrowserDisplayLine> lines = session.RetainedDisplayLines;
        long currentLineId = session.CurrentDisplayLineId;
        if (lastCurrentDisplayLineId > 0 && lastCurrentDisplayLineId != currentLineId)
            displayWindow.RemoveMeasurement(lastCurrentDisplayLineId);
        lastCurrentDisplayLineId = currentLineId;
        BrowserDisplayWindowSlice before = displayWindow.Calculate(lines, lines.Count - session.IslandLineCount, session.DisplayStructureGeneration, session.DisplayLineHeight);
        var requested = new HashSet<long>();
        bool currentVisible = false;
        for (int lineIndex = before.Start; lineIndex < before.End; lineIndex++)
        {
            BrowserDisplayLine line = lines[lineIndex];
            currentVisible |= line.LineId == currentLineId;
            if (line.LineId != currentLineId && !displayWindow.HasMeasurement(line.LineId)) requested.Add(line.LineId);
        }
        if (currentLineId > 0 && currentVisible
            && (lastMeasuredCurrentLineId != currentLineId || lastMeasuredCurrentDisplayGeneration != session.DisplayGeneration))
        {
            requested.Add(currentLineId);
        }
        if (requested.Count != 0)
        {
            long[] lineIds = requested.ToArray();
            DisplayWindowMeasurement[] values = await displayWindowModule.InvokeAsync<DisplayWindowMeasurement[]>("measureRendered", "game-screen", lineIds);
            displayWindowMeasureCount++;
            if (values.Any(value => value.LineId == currentLineId))
            {
                lastMeasuredCurrentLineId = currentLineId;
                lastMeasuredCurrentDisplayGeneration = session.DisplayGeneration;
            }
            if (displayWindow.ApplyMeasurements(values.Select(value => new BrowserDisplayLineMeasurement(value.LineId, value.Height)).ToArray()))
            {
                BrowserDisplayWindowSlice after = displayWindow.Calculate(lines, lines.Count - session.IslandLineCount, session.DisplayStructureGeneration, session.DisplayLineHeight);
                if (SliceChanged(before, after))
                {
                    if (displayWindowCorrectionCount++ < 2)
                    {
                        displayWindowRecalculateCount++;
                        StateHasChanged();
                        return;
                    }
                    displayWindowCorrectionLimitCount++;
                }
            }
        }
        if (displayWindow.FollowTail)
            await displayWindowModule.InvokeVoidAsync("scrollToBottom", "game-screen");
        else if (displayWindow.ScrollState.AnchorLineId > 0)
            await displayWindowModule.InvokeVoidAsync("restoreAnchor", "game-screen", displayWindow.ScrollState.AnchorLineId, displayWindow.ScrollState.AnchorOffsetPx);
    }

    // Explicit diagnostic sampling only; GC.GetTotalMemory is expensive in Wasm.
    [JSInvokable]
    public long ReadCurrentManagedMemoryBytes() => session?.CurrentManagedMemoryBytes ?? 0;

    [JSInvokable]
    public async Task OnDisplayWindowScroll(DisplayWindowScrollEvent value)
    {
        if (!IsDisplayWindowMode || session is null) return;
        BrowserDisplayWindowSlice before = displayWindow.Calculate(session.RetainedDisplayLines, session.RetainedDisplayLines.Count - session.IslandLineCount, session.DisplayStructureGeneration, session.DisplayLineHeight);
        displayWindowScrollCount++;
        displayWindowCorrectionCount = 0;
        if (!displayWindow.UpdateScroll(new(value.ScrollTop, value.ClientHeight, value.NearBottom, value.AnchorLineId, value.AnchorOffsetPx), value.DisplayStructureGeneration, session.DisplayStructureGeneration)) return;
        BrowserDisplayWindowSlice after = displayWindow.Calculate(session.RetainedDisplayLines, session.RetainedDisplayLines.Count - session.IslandLineCount, session.DisplayStructureGeneration, session.DisplayLineHeight);
        if (!SliceChanged(before, after)) return;
        session.RefreshAnimations(after.Start, after.End);
        displayWindowRecalculateCount++;
        await InvokeAsync(StateHasChanged);
    }

    static bool SliceChanged(BrowserDisplayWindowSlice before, BrowserDisplayWindowSlice after) =>
        before.Start != after.Start || before.End != after.End || before.FollowTail != after.FollowTail
        || before.NativePaintStart != after.NativePaintStart || before.NativePaintEnd != after.NativePaintEnd
        || Math.Abs(before.TopSpacerPx - after.TopSpacerPx) > 0.5 || Math.Abs(before.BottomSpacerPx - after.BottomSpacerPx) > 0.5;

    static string SpacerStyle(double height) => "height:" + Math.Max(0, height).ToString(System.Globalization.CultureInfo.InvariantCulture) + "px";

