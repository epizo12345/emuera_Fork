    BrowserLongRunningDecision ConfirmLongRunning(BrowserLongRunningNotice notice)
    {
        if (isP1C3 && titleBootstrapInProgress && IsStartupImageImport(notice.File))
            return new(true, "startup-image-import-auto-continue");
        if (longRunningModule is null)
            throw new InvalidOperationException("LONG_RUNNING_CONFIRM_SYNC_UNAVAILABLE");
        return longRunningModule.Invoke<BrowserLongRunningDecision>("confirmLongRunning", notice);
    }

    static bool IsStartupImageImport(string path) => path.Replace('\\', '/').EndsWith("関数/組み込み関数/画像関連関数/01_画像取り込み.ERB", StringComparison.OrdinalIgnoreCase);

    async Task AdvanceP1C2()
    {
        if (session is null || storeModule is null || storeHandle is null) return;
        if (session.Status is BrowserRuntimeStatus.Persisting or BrowserRuntimeStatus.AwaitingHost || session.IsFailed || session.MessageSkip.Active || macroActive)
            keyboardInput.Clear();
        else keyboardInput.Revalidate(session.PendingInput, session.SessionGeneration);
        primitiveTimer?.Cancel();
        scheduledTwaitRequestId = null;
        animationTimer?.Cancel();
        while (true)
        {
            try
            {
                while (session.Status == BrowserRuntimeStatus.Persisting)
                {
                    persistenceState = "persisting";
                    await session.DrainPersistenceAsync(async request =>
                    {
                        SetDiagnosticStage("indexeddb-commit-start");
                        StateHasChanged();
                        if (p1c5CommitDelayMilliseconds > 0)
                            await Task.Delay(p1c5CommitDelayMilliseconds);
                        StoreCommitResult committed = await CommitMutation(request, p1c5PersistenceFault);
                        SetDiagnosticStage("indexeddb-commit-end");
                        revision = committed.Revision;
                        durability = committed.Durability;
                        persistenceState = "committed";
                    });
                }
            }
            catch (Exception ex)
            {
                persistenceState = "failed";
                error = session.PersistenceError ?? ex.Message;
                progress = "保存に失敗しました";
                SetDiagnosticStage("persistence-failed");
                return;
            }
            if (session.Status == BrowserRuntimeStatus.AwaitingHost || !session.MessageSkip.Active) break;
            if (macroActive && session.PendingInput is { } macroPrompt
                && macroPrompt.Kind == BrowserInputKind.TimedVoid && !AllowMacroForcedWait)
            {
                SetDiagnosticStage("macro-boundary-stop");
                break;
            }
            if (session.PendingInput is { Kind: BrowserInputKind.TimedVoid } && !AllowMacroForcedWait) break;
            if (macroActive && session.PendingInput is { Kind: BrowserInputKind.MouseKey, TimeLimit: > 0 })
                break;
            long batchStarted = System.Diagnostics.Stopwatch.GetTimestamp();
            int resumed = 0;
            while (session.MessageSkip.Active && resumed < p1c5SkipBatchSize
                && System.Diagnostics.Stopwatch.GetElapsedTime(batchStarted).TotalMilliseconds < 8)
            {
                if (!session.ContinueMessageSkip(holdAtTimedPrimitive: macroActive, allowForcedTwait: AllowMacroForcedWait)) break;
                resumed++;
                if (session.Status == BrowserRuntimeStatus.Persisting) break;
            }
            StateHasChanged();
            await Task.Delay(1);
        }
        if (session.IsFailed)
        {
            titleBootstrapInProgress = false;
            titleReturnPending = false;
            runtimeFailureDiagnostic = session.FailureDiagnostic;
            if (saveImportTitlePending)
            {
                bool wasCancellationHandoff = saveImportCancellationHandoffPending;
                if (wasCancellationHandoff)
                {
                    error = "セーブ取込はキャンセル済みですが、タイトル起動に失敗しました。既存の保存データは変更していません。";
                    saveManagementMessage = "取込はキャンセル済みです。既存セーブは維持されています。タイトル起動のみ失敗しました。";
                }
                else
                {
                    error = "セーブ取込は完了しましたが、ゲーム起動に失敗しました。保存済みデータは残っています。再取込せず、詳細を確認してください。";
                    saveManagementMessage = "セーブの保存は完了しています。タイトル起動のみ失敗しました。取込を再実行しないでください。";
                    persistenceState = "committed";
                }
                saveImportTitlePending = false;
                ClearSaveImportHandoff();
                await SetHostStatusAsync(wasCancellationHandoff
                    ? "取込はキャンセル済みですが、タイトル起動に失敗しました。"
                    : "セーブ取込は完了しましたが、ゲーム起動に失敗しました。", busy: false, isError: true);
            }
            else
            {
                error = "実SYSTEM_TITLEがエラー停止しました。詳細は実行診断情報を開いて確認してください。";
                await SetHostStatusAsync("起動に失敗しました。実行診断を確認してください。", busy: false, isError: true);
            }
            progress = "タイトル実行失敗";
            SetDiagnosticStage("runtime-failed");
            return;
        }
        if (session.Status == BrowserRuntimeStatus.Succeeded)
        {
            StopMacroQueue("game-ended");
            titleBootstrapInProgress = false;
            titleReturnPending = false;
            p1c2Ready = false;
            progress = "ゲームは正常に終了しました";
            SetDiagnosticStage("game-ended");
            await SetHostStatusAsync("ゲームは終了しました。タイトルに戻れます。", busy: false);
            return;
        }
        p1c2Ready = session.PendingInput is { Kind: BrowserInputKind.Integer }
            && FlattenDisplay(session.DisplayLines.SelectMany(line => line.Parts)).Any(part => part.Kind == BrowserDisplayPartKind.Image)
            && FlattenDisplay(session.DisplayLines.SelectMany(line => line.Parts)).Any(part => part.Kind == BrowserDisplayPartKind.Button && part.Input == "0");
        progress = p1c2Ready ? "実タイトル表示・入力待ちへ到達" : $"実Runtime: {session.Status}";
        if (p1c2Ready)
        {
            await SetHostStatusAsync(string.Empty, busy: false);
            if (saveImportTitlePending)
            {
                saveImportTitlePending = false;
                saveManagementMessage = saveImportCancellationHandoffPending
                    ? "取込をキャンセルしました。既存の保存データを維持しています。"
                    : "セーブを取り込みました。タイトルのLOAD GAMEからプレイするデータを選択してください。";
                ClearSaveImportHandoff();
            }
        }
        if (p1c2Ready) SetDiagnosticStage("title-input-ready");
        if (p1c2Ready) titleBootstrapInProgress = false;
        if (p1c2Ready && titleReturnPending)
        {
            titleReturnPending = false;
            saveManagementMessage = "保存済みデータを維持してタイトルへ戻りました。";
            SetDiagnosticStage("title-return-ready");
        }
        if (isP1C3Integration && session.PendingInput is not null)
            SetDiagnosticStage($"integration-{integrationAction}-ready");
        SchedulePrimitiveTimeout();
        ScheduleAnimationRefresh();
        keyboardInput.Revalidate(session.PendingInput, session.SessionGeneration);
    }

    void ScheduleAnimationRefresh()
    {
        animationTimer?.Cancel();
        if (session is null || session.AnimationIntervalMilliseconds <= 0 || session.IsFailed || session.IsComplete) return;
        animationTimer = new CancellationTokenSource();
        CancellationToken token = animationTimer.Token;
        long sessionGeneration = session.SessionGeneration;
        int interval = session.AnimationIntervalMilliseconds;
        _ = RefreshAnimationLoop(sessionGeneration, interval, token);
    }

    async Task CompleteHostAwaitAsync(BrowserRuntimeSession active, BrowserAwaitRequest request,
        CancellationToken token, long macroOperation)
    {
        try
        {
            // After-render/rAF gives the browser an update opportunity, not a physical-paint guarantee.
            if (storeModule is not null) await storeModule.InvokeVoidAsync("waitForPaint");
            else await Task.Yield();
            while (!token.IsCancellationRequested && ReferenceEquals(active, session)
                && active.PendingAwait?.RequestId == request.RequestId)
            {
                double remaining = active.RemainingAwaitTime.TotalMilliseconds;
                if (remaining > 0) await Task.Delay(TimeSpan.FromMilliseconds(Math.Ceiling(remaining)), token);
                if (token.IsCancellationRequested || !ReferenceEquals(active, session)) return;
                if (!active.CompleteAwait(request.RequestId, request.SessionGeneration))
                {
                    if (active.RemainingAwaitTime > TimeSpan.Zero) continue;
                    return;
                }
                await AdvanceP1C2();
                if (macroActive && macroOperation == macroOperationId) await DrainMacroQueue();
                StateHasChanged();
                return;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            if (token.IsCancellationRequested || !ReferenceEquals(active, session)) return;
            active.CancelAwait();
            StopMacroQueue("await-failed");
            active.StopMessageSkip("await-failed");
            error = "AWAIT継続に失敗しました: " + ex.Message;
            await SetHostStatusAsync(error, busy: false, isError: true);
            StateHasChanged();
        }
    }

    async Task RefreshAnimationLoop(long sessionGeneration, int interval, CancellationToken token)
    {
        try
        {
            while (true)
            {
                await Task.Delay(interval, token);
                await InvokeAsync(() =>
                {
                    if (!token.IsCancellationRequested && session?.SessionGeneration == sessionGeneration)
                    {
                        if (session.RefreshAnimations(IsDisplayWindowMode ? animationFirstLine : 0, IsDisplayWindowMode ? animationEndLine : null))
                        {
                            animationRenderRequests++;
                            StateHasChanged();
                        }
                    }
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    void SchedulePrimitiveTimeout()
    {
        if (session?.PendingInput is not { Kind: BrowserInputKind.MouseKey, TimeLimit: > 0 } prompt) return;
        primitiveTimer?.Cancel();
        primitiveTimerScheduleCount++;
        primitiveTimer = new CancellationTokenSource();
        CancellationToken token = primitiveTimer.Token;
        long sessionGeneration = session.SessionGeneration;
        long displayGeneration = session.DisplayGeneration;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromMilliseconds(prompt.TimeLimit), token);
                await InvokeAsync(async () =>
                {
                    primitiveTimerCallbackCount++;
                    PointerContext pointer = await storeModule!.InvokeAsync<PointerContext>("inputContext", "game-screen");
                    if (!token.IsCancellationRequested && session?.PendingInput?.RequestId == prompt.RequestId
                        && session.SubmitPrimitive(new(prompt.RequestId, BrowserPrimitiveInputKind.Timeout, pointer.ButtonValue,
                            ButtonIsInteger: pointer.ButtonIsInteger,
                            SessionGeneration: sessionGeneration, DisplayGeneration: displayGeneration)))
                    {
                        SetDiagnosticStage("mousekey-timeout");
                        await AdvanceP1C2();
                        await DrainMacroQueue();
                        StateHasChanged();
                    }
                });
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    if (token.IsCancellationRequested || session?.SessionGeneration != sessionGeneration) return;
                    error = "INPUTMOUSEKEY timer失敗: " + ex.Message;
                    SetDiagnosticStage("mousekey-timer-failed");
                    StateHasChanged();
                });
            }
        }, token);
    }

    void ScheduleTwaitTimeout(BrowserInputPrompt prompt)
    {
        primitiveTimer?.Cancel();
        primitiveTimer = new CancellationTokenSource();
        CancellationToken token = primitiveTimer.Token;
        long sessionGeneration = session!.SessionGeneration;
        long displayGeneration = session.DisplayGeneration;
        scheduledTwaitRequestId = prompt.RequestId;
        scheduledTwaitSessionGeneration = sessionGeneration;
        twaitScheduleCount++;
        twaitTimerState = "scheduled";
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromMilliseconds(prompt.TimeLimit), token);
                await InvokeAsync(async () =>
                {
                    twaitCallbackCount++;
                    twaitTimerState = "callback";
                    if (!token.IsCancellationRequested && session?.PendingInput?.RequestId == prompt.RequestId
                        && session.SubmitTimeout(prompt.RequestId, sessionGeneration, displayGeneration))
                    {
                        twaitTimerState = "accepted";
                        SetDiagnosticStage(prompt.TimedInputName == "TWAIT" ? "twait-timeout" : "timed-input-timeout");
                        await AdvanceP1C2();
                        await DrainMacroQueue();
                        StateHasChanged();
                    }
                });
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    if (token.IsCancellationRequested || session?.SessionGeneration != sessionGeneration) return;
                    error = (prompt.TimedInputName == "TWAIT" ? "TWAIT" : prompt.TimedInputName) + " timer失敗: " + ex.Message;
                    twaitTimerState = "failed";
                    SetDiagnosticStage("twait-timer-failed");
                    StateHasChanged();
                });
            }
        }, token);
    }

    async Task SubmitDisplay((BrowserDisplayPart Part, MouseEventArgs Mouse) inputEvent)
    {
        BrowserDisplayPart part = inputEvent.Part;
        MouseEventArgs mouse = inputEvent.Mouse;
        BrowserRuntimeSession? activeSession = session;
        if (!dataReady || activeSession?.PendingInput is not { } prompt) return;
        if (prompt.Kind != BrowserInputKind.MouseKey && mouse.Button != 0)
        {
            if (mouse.Button != 2 || prompt is not { Kind: BrowserInputKind.Enter or BrowserInputKind.AnyKey, StopMessageSkip: false }) return;
            var envelope = new InputEnvelope(prompt.RequestId, string.Empty, BrowserInputSource.Keyboard,
                activeSession.SessionGeneration, activeSession.DisplayGeneration);
            if (!activeSession.SubmitWithMessageSkip(envelope)) return;
            input = string.Empty;
            SetDiagnosticStage("message-skip-start");
            await AdvanceP1C2();
            return;
        }
        // For Enter/AnyKey, the button markup is only old display content. The
        // click event on game-screen submits the captured current WAIT instead.
        if (prompt.Kind is BrowserInputKind.Enter or BrowserInputKind.AnyKey) return;
        if (part.Input is null) return;
        long previousRequestId = prompt.RequestId;
        long previousStructureGeneration = activeSession.DisplayStructureGeneration;
        long previousOutputGeneration = activeSession.ScriptOutputGeneration;
        bool currentActiveButton = part.Activation is { } activation
            && activation.RequestId == previousRequestId
            && activation.SessionGeneration == activeSession.SessionGeneration
            && activation.DisplayGeneration == previousStructureGeneration;
        PointerContext pointer = await ReadPointerContext(mouse.ClientX, mouse.ClientY);
        // A historical button is only a pointer target during primitive waits; its stale value belongs to another request.
        bool accepted = prompt.Kind == BrowserInputKind.MouseKey && !currentActiveButton
            ? activeSession.SubmitPrimitive(new(prompt.RequestId, BrowserPrimitiveInputKind.Click,
                Code: MouseCode(mouse.Button), X: pointer.X, Y: pointer.Y, ButtonIsInteger: false,
                SessionGeneration: activeSession.SessionGeneration, DisplayGeneration: activeSession.DisplayGeneration))
            : activeSession.SubmitDisplay(part, pointer.X, pointer.Y, MouseCode(mouse.Button));
        if (!accepted) return;
        SetDiagnosticStage(prompt.Kind == BrowserInputKind.MouseKey ? "mousekey-click" : "button-input");
        await AdvanceP1C2();
        if (IsDisplayWindowMode && currentActiveButton && ReferenceEquals(activeSession, session)
            && activeSession.ScriptOutputGeneration > previousOutputGeneration
            && activeSession.DisplayStructureGeneration != previousStructureGeneration
            && session?.PendingInput is { } nextPrompt && nextPrompt.RequestId != previousRequestId)
            displayWindow.ResumeFollowTail();
    }

