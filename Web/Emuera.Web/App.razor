            storeHandle = null;
        }
        if (pendingStagedImportNonce is not null && storeModule is not null)
            await storeModule.InvokeVoidAsync("clearStagedImport", pendingStagedImportNonce);
        pendingStagedImportNonce = null;
        Navigation.NavigateTo(BuildNormalTitleUri(importCompleted: false), forceLoad: true, replace: true);
