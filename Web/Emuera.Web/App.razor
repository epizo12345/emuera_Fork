    async Task PrepareP1C3IntegrationData(string action, int count)
    {
        string csv = Path.Combine(p1c1Root, "CSV", "GAMEBASE.CSV");
        string erbPath = Path.Combine(p1c1Root, "ERB", "R1.ERB");
        string erhPath = Path.Combine(p1c1Root, "ERB", "R1.ERH");
        Directory.CreateDirectory(Path.GetDirectoryName(csv)!);
        Directory.CreateDirectory(Path.GetDirectoryName(erbPath)!);
        File.WriteAllBytes(csv, await Http.GetByteArrayAsync("p1a-fixture/CSV/GAMEBASE.CSV"));
        var utf8Bom = new UTF8Encoding(true);
        File.WriteAllText(erhPath, "#DIM SAVEDATA R1_SLOT\n#DIM SAVEDATA R1_WIDE\n#DIMS SAVEDATA R1_TEXT\n#DIM GLOBAL SAVEDATA R1_GLOBAL\n", utf8Bom);
        var erb = new StringBuilder();
        erb.AppendLine("@SYSTEM_TITLE");
        if (action == "seed")
        {
            erb.AppendLine("R1_GLOBAL = 13579").AppendLine("SAVEGLOBAL");
            foreach (int slot in IntegrationSlots(count))
            {
                erb.AppendLine($"R1_SLOT = {slot}");
                erb.AppendLine($"R1_WIDE = {9007199254740993L + slot}");
                erb.AppendLine($"R1_TEXT = 境界確認-{slot}");
                erb.AppendLine($"SAVEDATA {slot}, \"R1-{slot}\"");
            }
            erb.AppendLine("PRINTL R1_SEED_DONE").AppendLine("WAIT").AppendLine("QUIT");
        }
        else if (action == "mutate")
        {
            AppendIntegrationSave(erb, 0, 100000, "上書き-0");
            AppendIntegrationSave(erb, 9, 100009, "上書き-9");
            erb.AppendLine("DELDATA 1").AppendLine("CHKDATA 1").AppendLine("PRINTFORML R1_DELETED_1={RESULT}");
            erb.AppendLine("PRINTL R1_MUTATE_DONE").AppendLine("WAIT").AppendLine("QUIT");
        }
        else if (action == "recreate")
        {
            AppendIntegrationSave(erb, 1, 200001, "再作成-1");
            erb.AppendLine("PRINTL R1_RECREATE_DONE").AppendLine("WAIT").AppendLine("QUIT");
        }
        else
        {
            erb.AppendLine("LOADGLOBAL").AppendLine("PRINTFORML R1_GLOBAL_VALUE={R1_GLOBAL}");
            erb.AppendLine("PRINTL R1_RESTORE_READY").AppendLine("INPUT").AppendLine("LOADDATA RESULT");
            erb.AppendLine("THROW R1_LOAD_FAILED").AppendLine("QUIT");
            erb.AppendLine().AppendLine("@SYSTEM_LOADEND").AppendLine("PRINTL R1_SYSTEM_LOADEND");
            erb.AppendLine().AppendLine("@EVENTLOAD");
            erb.AppendLine("PRINTFORML R1_LOADED_SLOT={LASTLOAD_NO},VALUE={R1_SLOT},WIDE={R1_WIDE}");
            erb.AppendLine("PRINTFORML R1_LOADED_TEXT=[%R1_TEXT%]");
            erb.AppendLine("INPUT").AppendLine("LOADDATA RESULT").AppendLine("THROW R1_LOAD_FAILED").AppendLine("QUIT");
        }
        File.WriteAllText(erbPath, erb.ToString(), utf8Bom);
        Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
        File.WriteAllBytes(Path.Combine(p1c1Root, "emuera.config"), Encoding.GetEncoding(932).GetBytes("セーブデータをバイナリ形式で保存する:YES"));
    }

    static int[] IntegrationSlots(int count) => count == 65
        ? Enumerable.Range(10, 64).ToArray()
        : Enumerable.Concat(Enumerable.Range(0, 240), new[] { 300, 400, 401 }).ToArray();

    static void AppendIntegrationSave(StringBuilder erb, int slot, int value, string text)
    {
        erb.AppendLine($"R1_SLOT = {value}");
        erb.AppendLine($"R1_WIDE = {9007199254740993L + value}");
        erb.AppendLine($"R1_TEXT = {text}");
        erb.AppendLine($"SAVEDATA {slot}, \"R1-{slot}\"");
    }

    async Task StartP1C2Host(string query)
    {
        string fixtureCase = QueryValue(query, "case") ?? "display-a";
        if (fixtureCase is not ("display-a" or "display-b" or "display-c" or "input" or "long-running" or "tooltip" or "mousekey-stale" or "macro-contract"))
            throw new InvalidDataException("host completion fixture caseが不正です");
        storeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./global-persistence.js");
        longRunningModule = await JS.InvokeAsync<IJSInProcessObjectReference>("import", "./long-running-prompt.js");
        storeHandle = "host-completion-no-persistence";
