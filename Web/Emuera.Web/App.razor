            File.WriteAllBytes(Path.Combine(p1c1Root, "ERB", "HOST.ERH"), await Http.GetByteArrayAsync("p1c2-host-fixture/ERB/long-running.ERH"));
        Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
