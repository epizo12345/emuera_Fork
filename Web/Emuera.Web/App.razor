    async Task StopAndDrainForTitleTransition(string stage)
    {
        awaitTimer?.Cancel();
        session?.CancelAwait();
        keyboardTransition = true;
        keyboardInput.Clear();
        StopMacroQueue(stage + "-macro-stop");
        session?.StopMessageSkip(stage + "-message-skip-stop");
        primitiveTimer?.Cancel();
        animationTimer?.Cancel();
        if (session?.Status == BrowserRuntimeStatus.Persisting)
        {
            var drainTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            await AdvanceP1C2();
            await RecordStartupProfilePhaseAsync("pending-persistence-drain", drainTimer,
                new { pendingCountAfterDrain = session?.PendingPersistenceCount ?? 0 });
        }
        if (session?.IsFailed == true || persistenceState == "failed")
            throw new InvalidOperationException("保存処理に失敗したため画面を移動できません");
    }

