    async Task SubmitP1C2Macro(string macroText)
    {
        if (macroActive || macroDraining || session?.PendingInput is null or { Kind: BrowserInputKind.TimedVoid } or { StopMessageSkip: true }) return;
#if ERB_EXECUTION_PROFILE
        long macroStarted = erbExecutionProfile ? System.Diagnostics.Stopwatch.GetTimestamp() : 0;
#endif
        IReadOnlyList<InputMacroToken> tokens = InputMacroSyntax.Expand(macroText);
        if (tokens.Count == 0) return;
        input = string.Empty;
#if ERB_EXECUTION_PROFILE
        if (erbExecutionProfile)
            session?.BeginErbExecutionProfile(erbProfileMode!, macroStarted);
#endif
        ++macroOperationId;
        macroQueue = new Queue<InputMacroToken>(tokens);
        macroTotalTokenCount = tokens.Count;
        macroConsumedTokenCount = 0;
        macroActive = true;
        StateHasChanged();
        if (storeModule is not null) await storeModule.InvokeVoidAsync("waitForPaint");
        await DrainMacroQueue();
    }

    async Task DrainMacroQueue()
    {
        if (macroDraining || macroQueue is null) return;
        var queue = macroQueue;
        var active = session;
        long operation = macroOperationId;
        long generation = active?.SessionGeneration ?? 0;
        macroDraining = true;
        try
        {
            while (macroActive && operation == macroOperationId && ReferenceEquals(active, session)
                && active?.SessionGeneration == generation && queue.Count > 0)
            {
                if (active.Status == BrowserRuntimeStatus.AwaitingHost) return;
                if (!dataReady || active.PendingInput is not { } pending) { StopMacroQueue(); return; }
                if (pending.StopMessageSkip) { StopMacroQueue("macro-stop-messkip"); return; }
                if (pending.Kind == BrowserInputKind.TimedVoid) return;
                var token = queue.Peek();
                await RefreshViewport();
                if (!macroActive || operation != macroOperationId || !ReferenceEquals(active, session)
                    || active.SessionGeneration != generation) return;
                if (active.PendingInput?.RequestId != pending.RequestId) continue;
                var envelope = new InputEnvelope(pending.RequestId, token.Value, BrowserInputSource.Keyboard,
                    generation, active.DisplayGeneration);
                if (!active.SubmitMacro(envelope, token.MessageSkip)) { StopMacroQueue("macro-input-rejected"); return; }
                queue.Dequeue(); // Consume only after the request gate accepted exactly once.
                macroConsumedTokenCount++;
                input = string.Empty;
                SetDiagnosticStage("macro-token");
                await AdvanceP1C2(); // Includes persistence acknowledgement before any continuation.
            }
            if (operation == macroOperationId && macroActive && queue.Count == 0)
            {
                macroQueue = null;
                macroActive = false;
                SetDiagnosticStage("macro-complete");
            }
        }
        finally { macroDraining = false; StateHasChanged(); }
    }

    void StopMacroQueue(string stage = "macro-boundary-stop")
    {
        ++macroOperationId;
        macroQueue = null;
        macroActive = false;
        SetDiagnosticStage(stage);
    }

    async Task SubmitP1C2TextCore(bool startMessageSkip, bool forceEmpty = false, string? directValue = null)
    {
        if (!dataReady || session?.PendingInput is not { } prompt) return;
        if (directValue is null && !startMessageSkip && !forceEmpty && input.Contains('(', StringComparison.Ordinal))
        {
            await SubmitP1C2Macro(input);
            return;
        }
        PointerContext pointer = await ReadPointerContext();
        session.SetMousePosition(pointer.X, pointer.Y);
        var envelope = new InputEnvelope(prompt.RequestId, forceEmpty ? string.Empty : directValue ?? input, BrowserInputSource.Keyboard, session.SessionGeneration, session.DisplayGeneration);
        bool accepted = startMessageSkip ? session.SubmitWithMessageSkip(envelope) : session.Submit(envelope);
        if (!accepted) return;
        input = string.Empty;
        SetDiagnosticStage(startMessageSkip ? "message-skip-start" : "text-input");
        await AdvanceP1C2();
    }

