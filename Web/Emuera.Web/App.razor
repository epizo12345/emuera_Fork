    async Task SubmitPrimitiveKey(KeyboardEventArgs keyboard)
    {
#if ERB_EXECUTION_PROFILE
        TraceGameplayStage("handler-enter:" + keyboard.Code);
#endif
        var active = session;
        var pending = active?.PendingInput;
        long? startSession = active?.SessionGeneration;
        string reason;
        (string Code, string Key)? deferred = null;
        if (keyboard.MetaKey || (pending?.Kind != BrowserInputKind.MouseKey &&
            (((keyboard.CtrlKey || keyboard.AltKey) && !ModifierOnly(keyboard.Code)) || keyboard.Code is "Tab" or "Backspace"))) reason = "modifier";
        else
        {
            BrowserKeyInput? mapped = BrowserInputMapping.MapKey(keyboard.Code, keyboard.Key, keyboard.CtrlKey, keyboard.ShiftKey, keyboard.AltKey);
            active?.SetKeyState(mapped?.Code ?? 0, true);
            if (keyboard.Code == "Escape" && active?.MessageSkip.Active == true)
            { StopMessageSkip(); keyboardInput.Clear(); reason = "message-skip-stop"; }
            else if (!dataReady || keyboardTransition || macroActive || active?.MessageSkip.Active == true || active?.Status == BrowserRuntimeStatus.Persisting)
            { keyboardInput.Clear(); reason = !dataReady ? "not-data-ready" : "input-gate"; }
            else
            {
                keyboardInput.KeyDown(keyboard.Code, keyboard.Repeat, pending, startSession ?? 0);
                if (keyboardInput.TryBegin(keyboard.Code, keyboard.Key, keyboard.Repeat, pending, startSession ?? 0, out reason))
                {
                    try
                    {
                        bool movement = keyboard.Code is "KeyW" or "KeyA" or "KeyS" or "KeyD"
                            && pending is { Kind: BrowserInputKind.String, OneInput: true, TimeLimit: <= 0, TimedInputName: null or "" };
                        bool heldMovement = keyboard.Repeat && movement;
                        bool presentationAllowed = true;
                        if (movement && !keyboard.Repeat && displayWindowModule is not null)
                            presentationAllowed = await displayWindowModule.InvokeAsync<bool>("oneInputPresentation", startSession, pending!.RequestId);
                        if (heldMovement && displayWindowModule is not null)
                        {
                            StateHasChanged();
                            if (!await displayWindowModule.InvokeAsync<bool>("presentationOpportunity"))
                                ResetPrimitiveKeys(new FocusEventArgs());
                        }
                        if (!presentationAllowed || movement && (!ReferenceEquals(active, session) || session?.PendingInput?.RequestId != pending?.RequestId || keyboardTransition))
                            reason = "movement-stale-after-frame";
                        else if (heldMovement && (!ReferenceEquals(active, session) || session?.PendingInput?.RequestId != pending?.RequestId
                            || !keyboardInput.IsHeld(keyboard.Code, session.PendingInput, session.SessionGeneration)))
                            reason = "repeat-stale-after-frame";
                        else reason = await SubmitPrimitiveKeyCore(keyboard);
                    }
                    finally
                    {
                        if (keyboardTransition || session?.IsFailed != false || session.Status == BrowserRuntimeStatus.Persisting
                            || session.MessageSkip.Active || macroActive) keyboardInput.Clear();
                        deferred = keyboardInput.Complete(session?.PendingInput, session?.SessionGeneration ?? 0);
                    }
                }
            }
        }
        if (deferred is { } key)
            await SubmitPrimitiveKey(new KeyboardEventArgs { Code = key.Code, Key = key.Key, Repeat = true });
    }

    async Task<string> SubmitPrimitiveKeyCore(KeyboardEventArgs keyboard)
    {
        BrowserKeyInput? mapped = BrowserInputMapping.MapKey(keyboard.Code, keyboard.Key, keyboard.CtrlKey, keyboard.ShiftKey, keyboard.AltKey);
        if (session?.PendingInput is not { } pending) return "no-pending-input";
        if (keyboard.Key == "Enter" && (pending.Kind == BrowserInputKind.Enter
            || pending is { Kind: BrowserInputKind.String or BrowserInputKind.Integer, OneInput: true }))
        {
            await SubmitP1C2TextCore(startMessageSkip: false, forceEmpty: true);
            return session?.PendingInput?.RequestId != pending.RequestId ? "accepted" : "input-gate";
        }
        if (pending.Kind == BrowserInputKind.AnyKey && !ModifierOnly(keyboard.Code))
        {
            await SubmitP1C2TextCore(startMessageSkip: false, forceEmpty: true);
            return session?.PendingInput?.RequestId != pending.RequestId ? "accepted" : "input-gate";
        }
        if (pending is { Kind: BrowserInputKind.String or BrowserInputKind.Integer, OneInput: true }
            && keyboard.Key.Length == 1 && !keyboard.CtrlKey && !keyboard.AltKey && !keyboard.MetaKey)
        {
            await SubmitP1C2TextCore(startMessageSkip: false, directValue: keyboard.Key);
            return session?.PendingInput?.RequestId != pending.RequestId ? "accepted" : "input-gate";
        }
        if (acceptedPrimitiveModifier is not null || pending.Kind != BrowserInputKind.MouseKey) return "wrong-kind";
        BrowserInputPrompt prompt = pending;
        if (mapped is null) return "other";
        PointerContext pointer = await ReadPointerContext();
        session.SetMousePosition(pointer.X, pointer.Y);
        if (!session.SubmitPrimitive(new(prompt.RequestId, BrowserPrimitiveInputKind.Key, pointer.ButtonValue, mapped.Code, mapped.KeyData,
            ButtonIsInteger: pointer.ButtonIsInteger,
            SessionGeneration: session.SessionGeneration, DisplayGeneration: session.DisplayGeneration))) return "input-gate";
        if (keyboard.Code.StartsWith("Shift", StringComparison.Ordinal) || keyboard.Code.StartsWith("Control", StringComparison.Ordinal) || keyboard.Code.StartsWith("Alt", StringComparison.Ordinal))
            acceptedPrimitiveModifier = keyboard.Code;
        SetDiagnosticStage("mousekey-key");
        await AdvanceP1C2();
        return "accepted";
    }

    static bool ModifierOnly(string code) => code.StartsWith("Shift", StringComparison.Ordinal)
        || code.StartsWith("Control", StringComparison.Ordinal)
        || code.StartsWith("Alt", StringComparison.Ordinal)
        || code is "MetaLeft" or "MetaRight";

    KeyboardReleaseReceiver? keyboardReleaseReceiver;
    Action<KeyboardEventArgs> KeyReleaseHandler => (keyboardReleaseReceiver ??= new(this)).Release;

    // Keyup changes GETKEY/held state, not the displayed model.
    sealed class KeyboardReleaseReceiver(App owner) : IHandleEvent
    {
