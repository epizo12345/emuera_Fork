    async Task ReturnToTitle()
    {
        if (saveManagerMode && !importInProgress)
        {
            await CloseSaveManager();
            return;
        }
        if (!isP1C3 || isP1C3Integration || isP1C4Small || session is null || importInProgress || keyboardTransition || titleBootstrapInProgress) return;
        try
        {
            await StopAndDrainForTitleTransition("title-return");
            error = null;
            runtimeFailureDiagnostic = null;
            p1c2Ready = false;
            displayWindowSession = null;
            titleBootstrapInProgress = true;
            titleReturnPending = true;
            await SetHostStatusAsync("タイトルを起動しています…");
            SetDiagnosticStage("title-script-start");
            session.ReturnToTitle();
            _ = GC.GetTotalMemory(forceFullCollection: true);
            SetDiagnosticStage("title-script-end");
            await AdvanceP1C2();
        }
        catch (Exception ex)
        {
            titleBootstrapInProgress = false;
            titleReturnPending = false;
            saveManagementMessage = ex.Message;
            error = session.PersistenceError ?? ex.Message;
            await SetHostStatusAsync("タイトルへ戻れません。保存データはセーブ管理から書き出せます。", busy: false, isError: true);
        }
        finally { keyboardTransition = false; }
    }

    async Task ImportP1C2Global(InputFileChangeEventArgs change)
    {
        const long maxBytes = 16L * 1024 * 1024;
        if (!dataReady || storeModule is null || storeHandle is null || !importMode || !importFormReady || importInProgress) return;
        importInProgress = true;
        try
        {
            IBrowserFile file = change.File;
            if (!string.Equals(file.Name, "global.sav", StringComparison.OrdinalIgnoreCase) || file.Size is <= 0 or > maxBytes)
                throw new InvalidDataException("有効なglobal.savを選択してください");
            using Stream inputStream = file.OpenReadStream(maxBytes);
            using var memory = new MemoryStream((int)file.Size);
            await inputStream.CopyToAsync(memory);
            byte[] bytes = memory.ToArray();
            SetDiagnosticStage("file-read-complete");
            BrowserRuntimeSession validator = await BrowserRuntimeSession.StartPersistentBootstrapAsync(p1c1Root, bytes);
            GlobalCodecDiagnosticResult diagnostic = validator.RunGlobalCodecDiagnostic(resave: false);
            if (!diagnostic.LoadSucceeded || validator.PendingPersistenceCount != 0 || validator.DoScriptCallCount != 0)
                throw new InvalidDataException("既存LoadGlobalが選択ファイルを拒否しました");
            SetDiagnosticStage("indexeddb-commit-start");
            StoreCommitResult committed = await storeModule.InvokeAsync<StoreCommitResult>("commit", storeHandle, bytes, "import-" + Guid.NewGuid().ToString("N"), string.Empty);
            SetDiagnosticStage("indexeddb-commit-end");
            revision = committed.Revision;
            durability = committed.Durability;
            persistenceState = "committed";
            loadSource = "file-import";
            importFormReady = false;
            await StartP1C2Title(bytes);
        }
        catch (Exception ex)
        {
            error = "global.sav import失敗: " + ex.Message;
            persistenceState = "failed";
        }
        finally
        {
            importInProgress = false;
        }
    }

    async Task EnsureP1C3DataPreparedForSaveImportAsync()
    {
        if (dataReady) return;
        await PrepareP1C1Data(p1c1Root, real: true, fixtureCase: "default");
        dataReady = true;
    }

    async Task ImportP1C3Files(InputFileChangeEventArgs change)
    {
        const long maxFileBytes = 256L * 1024 * 1024;
        const long maxTotalBytes = 512L * 1024 * 1024;
        if (storeModule is null || storeHandle is null || importInProgress || (!saveManagerMode && !saveImportReadProbe && !isP1C3Integration && !isP1C4Small))
            return;
        importInProgress = true;
        persistenceState = "validating";
        error = null;
        saveManagementMessage = null;
        saveImportSelectedCount = 0;
        saveImportBytesRead = 0;
        saveImportTrace.Clear();
        BrowserRuntimeSession? validator = null;
        bool importCommitted = false;
        bool startTitleAfterImport = false;
        bool navigateToTitleAfterImport = false;
        bool returnToTitleAfterOverwriteCancellation = false;
        bool stagedImportCleanupSucceeded = true;
        bool startupProfileNavigationRequested = false;
        bool persistedGlobalExistsBeforeImport = persistedFiles.Any(file => !file.Deleted
            && string.Equals(file.LogicalFilename, "global.sav", StringComparison.OrdinalIgnoreCase));
        var importedInputHashes = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        async Task RecordCodecTimingAsync(BrowserRuntimeSession runtime, string logicalFilename,
            System.Diagnostics.Stopwatch? timer, string? inputSha256 = null)
        {
            BrowserCodecValidationTiming? timing = runtime.CodecValidationProfile.LastOrDefault();
            await RecordStartupProfilePhaseAsync("codec-validation-" + (timing?.Operation ?? "failed"), timer, new
            {
                logicalFilename,
                inputBytes = timing?.InputBytes ?? 0,
                inputHashMilliseconds = timing?.InputHashMilliseconds ?? 0,
                loadMilliseconds = timing?.LoadMilliseconds ?? 0,
                summaryMilliseconds = timing?.SummaryMilliseconds ?? 0,
                succeeded = timing?.Succeeded ?? false,
                inputSha256 = inputSha256 ?? timing?.InputSha256
            }, "inclusive");
        }
        SetSaveImportStage("save-import-event-enter");
        try
        {
            await BeginStartupImportProfileAsync(saveManagerMode ? "save-manager-import-to-title" : "runtime-import-to-title",
                new { entry = "selected-file-change-event" });
            await SetSaveImportStatusAsync("ファイルを確認しています…");
            SetSaveImportStage("save-import-file-list-start");
            var fileListTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            IReadOnlyList<IBrowserFile> selected = change.GetMultipleFiles(64);
            await RecordStartupProfilePhaseAsync("selected-file-list-validation", fileListTimer, new { count = selected.Count });
            saveImportSelectedCount = selected.Count;
            SetSaveImportStage("save-import-file-list-end");
            if (selected.Count == 0)
            {
                persistenceState = "cancelled";
                await FinishStartupImportProfileAsync("file-selection-empty");
                await SetHostStatusAsync(string.Empty, busy: false);
                saveManagementMessage = "ファイル選択を取り消しました。保存済みデータは変更されていません。";
                return;
            }
            if (selected.Sum(file => file.Size) > maxTotalBytes)
                throw new InvalidDataException("import件数または総量が不正です");
            var imported = new Dictionary<string, byte[]>(StringComparer.OrdinalIgnoreCase);
            var fileReadTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            try
            {
                foreach (IBrowserFile file in selected)
                {
                    string logicalFilename = NormalizeImportedSaveFilename(file.Name);
                    if (!imported.TryAdd(logicalFilename, []))
                        throw new InvalidDataException($"同じ保存番号が重複しています: {logicalFilename}");
                    if (file.Size is <= 0 or > maxFileBytes)
                        throw new InvalidDataException($"保存ファイルのサイズが不正です: {logicalFilename}");
                    SetSaveImportStage("save-import-open-stream-start");
                    using Stream inputStream = file.OpenReadStream(maxFileBytes);
                    SetSaveImportStage("save-import-open-stream-end");
                    using var memory = new MemoryStream((int)file.Size);
                    SetSaveImportStage("save-import-copy-start");
                    await inputStream.CopyToAsync(memory);
                    saveImportBytesRead += memory.Length;
                    SetSaveImportStage("save-import-copy-end");
                    imported[logicalFilename] = memory.ToArray();
                }
            }
            finally
            {
                await RecordStartupProfilePhaseAsync("selected-file-read-and-managed-copy", fileReadTimer, new
                {
                    selectedCount = selected.Count,
                    completedCount = imported.Count,
                    bytesRead = saveImportBytesRead
                });
            }
            SetSaveImportStage("save-import-file-read-complete");
            await SetStartupProfileInputFilesAsync(imported.Select(pair => (object)new
            {
                logicalFilename = pair.Key,
                bytes = pair.Value.LongLength,
                sha256 = (string?)null
            }), persistedGlobalExistsBeforeImport);
            if (saveImportReadProbe)
            {
                persistenceState = "read-probe-complete";
                saveManagementMessage = $"{imported.Count}件の保存ファイルを読み取りました。";
                await FinishStartupImportProfileAsync("read-probe-complete");
                await SetHostStatusAsync(string.Empty, busy: false);
                return;
            }

            if (!saveManagerMode)
            {
                SetSaveImportStage("save-import-session-stop-start");
                var runtimeStopTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
                await StopAndDrainForTitleTransition("save-import");
                await RecordStartupProfilePhaseAsync("runtime-stop-and-persistence-drain-inclusive", runtimeStopTimer,
                    new { pendingPersistenceCount = session?.PendingPersistenceCount ?? 0 }, "inclusive");
                session = null;
                BrowserRuntimeSession.ReleaseBootstrapResources();
                SetSaveImportStage("save-import-session-stop-end");
            }

            Dictionary<string, byte[]> staged = CurrentSaveFiles();
            foreach ((string name, byte[] bytes) in imported) staged[name] = bytes;
            if (!staged.ContainsKey("global.sav"))
                throw new InvalidDataException("global.savも選択してください");

            string[] overwriteNames = imported.Keys.Where(name => persistedFiles.Any(file => !file.Deleted
                && string.Equals(file.LogicalFilename, name, StringComparison.OrdinalIgnoreCase))).ToArray();
            if (overwriteNames.Length > 0)
            {
                await SetSaveImportStatusAsync("既存ファイルの上書きを確認しています…");
                var overwriteDecisionTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
                bool overwriteAccepted = await JS.InvokeAsync<bool>("confirm", $"次の保存ファイルを上書きします。よろしいですか？\n{string.Join("\n", overwriteNames)}");
                await RecordStartupProfilePhaseAsync("overwrite-confirmation", overwriteDecisionTimer,
                    new { accepted = overwriteAccepted, fileCount = overwriteNames.Length }, "user-decision");
                if (!overwriteAccepted)
                {
                    persistenceState = "cancelled";
                    returnToTitleAfterOverwriteCancellation = true;
                    await SetHostStatusAsync("取込をキャンセルしました。タイトルを起動する準備をしています…");
                    saveManagementMessage = "上書きを取り消しました。既存の保存データは変更されていません。";
                    return;
                }
            }

        if (!dataReady)
        {
            await SetSaveImportStatusAsync("検証用データを準備しています…");
            var validationPackageTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            await EnsureP1C3DataPreparedForSaveImportAsync();
            await RecordStartupProfilePhaseAsync("validation-game-data-preparation-inclusive", validationPackageTimer, new
            {
                packageCacheState,
                packageCacheHits,
                packageCacheMisses,
                httpRequests,
                transferBytes,
                extractMilliseconds,
                extractedBytes,
                packageFiles,
                packageLookups
            }, "inclusive");
        }
            await SetSaveImportStatusAsync("セーブ形式を検証しています…");
            SetSaveImportStage("save-import-validator-start");
            var validatorBootstrapTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            validator = await BrowserRuntimeSession.StartSavePersistentBootstrapAsync(p1c1Root, staged,
                captureProcessInitializeProfile: startupImportProfileEnabled);
            await RecordStartupProfilePhaseAsync("validation-runtime-bootstrap-inclusive", validatorBootstrapTimer, new
            {
                validator.ConfigLoadMilliseconds,
                validator.PreloadMilliseconds,
                validator.ProcessInitializeMilliseconds,
                validator.BootstrapElapsedMilliseconds,
                processInitialize = validator.ProcessInitializeProfile
            }, "inclusive");
            SetSaveImportStage("save-import-validator-ready");
            SetSaveImportStage("save-import-codec-start");
            GlobalCodecDiagnosticResult global;
            var globalCodecTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            try { global = validator.RunGlobalCodecDiagnostic(resave: false); }
            finally { await RecordCodecTimingAsync(validator, "global.sav", globalCodecTimer); }
            if (imported.ContainsKey("global.sav")) importedInputHashes["global.sav"] = global.InputSha256;
            SetSaveImportStage("save-import-codec-end");
            if (!global.LoadSucceeded)
                throw new InvalidDataException("既存LoadGlobalがglobal.savを拒否しました");
            if (isP1C4State)
            {
                if (imported.Count != 2 || !imported.ContainsKey("global.sav") || !imported.ContainsKey("save218.sav"))
                    throw new InvalidDataException("P1C4状態診断にはglobal.savとsave218.savだけが必要です");
                stateDiagnostic = validator.RunSaveStateDiagnostic(218);
                if (!stateDiagnostic.LoadSucceeded)
                    throw new InvalidDataException("既存LoadFromがsave218.savを拒否しました");
                if (validator.DoScriptCallCount != 0 || validator.PendingPersistenceCount != 0)
                    throw new InvalidOperationException("P1C4状態診断で実行または保存が発生しました");
                session = validator;
                validator = null;
                persistenceState = "read-only";
                loadSource = "file-import-read-only";
                importFormReady = false;
                progress = "P1C4戦闘後状態を読取専用で読み込みました";
                await SetHostStatusAsync(string.Empty, busy: false);
                SetDiagnosticStage("p1c4-state-ready");
                return;
            }
            foreach (string name in imported.Keys.Where(name => name != "global.sav"))
            {
                int slot = ParseSaveSlot(name);
                SaveCodecDiagnosticResult diagnostic;
                var saveCodecTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
                try { diagnostic = validator.RunSaveCodecDiagnostic(slot); }
                finally { await RecordCodecTimingAsync(validator, name, saveCodecTimer); }
                importedInputHashes[name] = diagnostic.InputSha256;
                if (!diagnostic.LoadSucceeded)
                    throw new InvalidDataException($"既存LoadFromが{name}を拒否しました");
            }
            await SetStartupProfileInputFilesAsync(imported.Select(pair => (object)new
            {
                logicalFilename = pair.Key,
                bytes = pair.Value.LongLength,
                sha256 = importedInputHashes.GetValueOrDefault(pair.Key)
            }), persistedGlobalExistsBeforeImport);
            if (validator.DoScriptCallCount != 0 || validator.PendingPersistenceCount != 0)
                throw new InvalidOperationException("sav import検証で実行または保存が発生しました");
            validator = null;
            BrowserRuntimeSession.ReleaseBootstrapResources();
            SetSaveImportStage("save-import-validator-released");

            SaveMutation[] mutations = imported.Select(pair => new SaveMutation(
                "import-" + Guid.NewGuid().ToString("N"), pair.Key, SaveMutationKind.Put, pair.Value)).ToArray();
            await SetSaveImportStatusAsync("検証済みファイルを保存しています…");
            SetSaveImportStage("save-import-commit-start");
            var commitTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            StoreMutationBatchResult committed = await storeModule.InvokeAsync<StoreMutationBatchResult>(
                "commitMutations", storeHandle, mutations, string.Empty);
            await RecordStartupProfilePhaseAsync("indexeddb-import-commit", commitTimer, new
            {
                fileCount = mutations.Length,
                bytes = imported.Values.Sum(bytes => (long)bytes.Length),
                durability = committed.Durability
            });
            SetSaveImportStage("save-import-commit-end");
            foreach (StoreMutationResult result in committed.Files)
                UpsertPersisted(result, imported[result.LogicalFilename]);
            importCommitted = true;
            durability = committed.Durability;
            persistenceState = "committed";
            loadSource = "file-import";
            saveManagementMessage = $"{imported.Count}件の保存ファイルを取り込みました。タイトルのLOAD GAMEから選択できます。";
            runtimeFailureDiagnostic = null;
            navigateToTitleAfterImport = saveManagerMode;
            startTitleAfterImport = !saveManagerMode;
        }
        catch (InvalidDataException ex) when (ex.Message == "global.savも選択してください")
        {
            persistenceState = "validation-refused";
            error = null;
            await SetHostStatusAsync(ex.Message, busy: false, isError: true);
            saveManagementMessage = ex.Message;
        }
        catch (Exception ex)
        {
            persistenceState = importCommitted ? "committed" : "failed";
            if (importCommitted)
            {
                error = null;
                saveManagementMessage = "セーブの保存は完了しましたが、タイトル起動を開始できませんでした。保存済みデータは残っています。取込を再実行しないでください。";
                await SetHostStatusAsync("保存済みですが、ゲーム起動に失敗しました。", busy: false, isError: true);
            }
            else if (saveManagerMode)
            {
                error = null;
                saveManagementMessage = "通常sav import失敗: " + ex.Message;
                await SetHostStatusAsync("セーブ取込に失敗しました。保存済みデータは変更されていません。", busy: false, isError: true);
            }
            else
            {
                error = "通常sav import失敗: " + ex.Message;
                await SetHostStatusAsync("セーブ取込に失敗しました。保存済みデータは変更されていません。", busy: false, isError: true);
            }
        }
        finally
        {
            if (validator is not null)
                BrowserRuntimeSession.ReleaseBootstrapResources();

            async Task<bool> CleanupStagedImportAsync()
            {
                var cleanupTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
                bool cleanupSucceeded = true;
                try
                {
                    if (pendingStagedImportNonce is null) return true;
                    if (storeModule is null)
                    {
                        stagedImportCleanupSucceeded = false;
                        cleanupSucceeded = false;
                        await SetHostStatusAsync(importCommitted
                            ? "保存済みですが、一時データを消去できず起動を保留しています。"
                            : "取込一時データを消去できませんでした。画面の結果を確認してください。", busy: false, isError: true);
                        saveManagementMessage = (saveManagementMessage ?? string.Empty) + " 一時データを消去できません: 保存領域を利用できません。";
                        return false;
                    }
                    // clearStagedImport returns false when applyStagedImport already consumed the stage;
                    // InvokeVoidAsync intentionally treats that idempotent result as a completed cleanup.
                    await storeModule.InvokeVoidAsync("clearStagedImport", pendingStagedImportNonce);
                    return true;
                }
                catch (Exception ex)
                {
                    stagedImportCleanupSucceeded = false;
                    cleanupSucceeded = false;
                    await SetHostStatusAsync(importCommitted
                        ? "保存済みですが、一時データを消去できず起動を保留しています。"
                        : "取込一時データを消去できませんでした。画面の結果を確認してください。", busy: false, isError: true);
                    saveManagementMessage = (saveManagementMessage ?? string.Empty) + " 一時データを消去できません: " + ex.Message;
                    return false;
                }
                finally
                {
                    pendingStagedImportNonce = null;
                    await RecordStartupProfilePhaseAsync("cache-staged-import-cleanup", cleanupTimer, new { cleanupSucceeded });
                }
            }

            async Task BeginOverwriteCancellationHandoffAsync()
            {
                importInProgress = true;
                saveImportTitlePending = true;
                saveImportCancellationHandoffPending = true;
                await SetHostStatusAsync("取込をキャンセルしました。タイトルを起動しています…");
            }

            async Task<bool> ReleaseStoreLockForCancellationAsync()
            {
                if (storeModule is null || storeHandle is null)
                    return false;
                var lockTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
                bool released = await storeModule.InvokeAsync<bool>("release", storeHandle);
                await RecordStartupProfilePhaseAsync("web-lock-release-after-overwrite-cancel", lockTimer, new { released });
                if (released)
                    storeHandle = null;
                return released;
            }

            async Task NavigateToNormalTitleAfterCancellationAsync()
            {
                SetSaveImportStage("save-import-cancel-return-start");
                await MarkStartupProfileNavigationAsync("overwrite-cancel-title-navigation");
                startupProfileNavigationRequested = true;
                Navigation.NavigateTo(BuildNormalTitleUri(importCompleted: false, importCancelled: true),
                    forceLoad: true, replace: true);
            }

            async Task StartRuntimeTitleAfterCancellationAsync()
            {
                SetSaveImportStage("save-import-cancel-return-start");
                await RecordStartupProfileEventAsync("overwrite-cancel-same-page-title-start");
                await StartP1C3Title(CurrentSaveFiles());
                SetSaveImportStage("save-import-cancel-return-end");
            }

            try
            {
                SaveImportFinalizationResult finalization = await BrowserSaveImportFinalizer.FinishAsync(
                    returnToTitleAfterOverwriteCancellation,
                    saveManagerMode,
                    CleanupStagedImportAsync,
                    BeginOverwriteCancellationHandoffAsync,
                    ReleaseStoreLockForCancellationAsync,
                    NavigateToNormalTitleAfterCancellationAsync,
                    StartRuntimeTitleAfterCancellationAsync);
                stagedImportCleanupSucceeded = finalization != SaveImportFinalizationResult.CleanupFailed;
                if (finalization == SaveImportFinalizationResult.CleanupFailed
                    && returnToTitleAfterOverwriteCancellation)
                    saveManagementMessage = (saveManagementMessage ?? string.Empty) + " タイトル復帰は保留しました。一時取込データの後始末を確認してください。";
                else if (finalization == SaveImportFinalizationResult.LockReleaseFailed)
                    await ShowOverwriteCancellationHandoffFailure("キャンセル後の保存領域lock解放を確認できませんでした。");
            }
            catch (Exception ex)
            {
                if (returnToTitleAfterOverwriteCancellation)
                    await ShowOverwriteCancellationHandoffFailure(ex.Message);
                else
                {
                    stagedImportCleanupSucceeded = false;
                    await SetHostStatusAsync(importCommitted
                        ? "保存済みですが、一時データを消去できず起動を保留しています。"
                        : "取込一時データを消去できませんでした。画面の結果を確認してください。", busy: false, isError: true);
                    saveManagementMessage = (saveManagementMessage ?? string.Empty) + " 取込の後始末に失敗しました: " + ex.Message;
                }
            }
            finally
            {
                importInProgress = false;
            }
        }
        if (!importCommitted || (!startTitleAfterImport && !navigateToTitleAfterImport))
        {
            if (!startupProfileNavigationRequested)
                await FinishStartupImportProfileAsync(returnToTitleAfterOverwriteCancellation
                    ? "overwrite-cancelled-title-handoff-incomplete" : persistenceState);
            return;
        }
        if (!stagedImportCleanupSucceeded)
        {
            saveManagementMessage = (saveManagementMessage ?? string.Empty) + " 保存は完了しています。取込一時データの後始末を確認してからタイトルへ移動してください。";
            return;
        }

        importInProgress = true;
        saveImportTitlePending = true;
        await SetHostStatusAsync("取込完了：ゲームを起動しています…");
        if (navigateToTitleAfterImport)
        {
            try
            {
                SetSaveImportStage("save-import-runtime-restart-start");
                var lockTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
                bool released = await storeModule.InvokeAsync<bool>("release", storeHandle);
                await RecordStartupProfilePhaseAsync("web-lock-release-before-title-navigation", lockTimer, new { released });
                if (!released)
                    throw new InvalidOperationException("保存領域lockの解放を確認できませんでした");
                storeHandle = null;
                await MarkStartupProfileNavigationAsync("import-success-title-navigation");
                startupProfileNavigationRequested = true;
                Navigation.NavigateTo(BuildNormalTitleUri(importCompleted: true), forceLoad: true, replace: true);
            }
            catch (Exception ex)
            {
                importInProgress = false;
                saveImportTitlePending = false;
                saveManagementMessage = "セーブの保存は完了しましたが、通常起動へ移動できませんでした。保存済みデータは残っています。取込を再実行しないでください。" + " " + ex.Message;
                await SetHostStatusAsync("保存済みですが、ゲーム起動に失敗しました。", busy: false, isError: true);
            }
            return;
        }

        try
        {
            SetSaveImportStage("save-import-runtime-restart-start");
            await StartP1C3Title(CurrentSaveFiles());
            SetSaveImportStage("save-import-runtime-restart-end");
            if (isP1C3Integration && error is null)
                SetDiagnosticStage("integration-import-ready");
        }
        catch (Exception ex)
        {
            persistenceState = "committed";
            error = "セーブ取込は完了しましたが、ゲーム起動に失敗しました。保存済みデータは残っています。再取込せず、詳細を確認してください。";
            startupErrorDetails = ex.ToString();
                saveManagementMessage = "セーブの保存は完了しています。タイトル起動のみ失敗しました。取込を再実行しないでください。";
                saveImportTitlePending = false;
                await SetHostStatusAsync("セーブ取込は完了しましたが、ゲーム起動に失敗しました。", busy: false, isError: true);
                await FinishStartupImportProfileAsync("import-saved-title-navigation-failed");
        }
        finally
        {
            importInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task ShowOverwriteCancellationHandoffFailure(string detail)
    {
        importInProgress = false;
        saveImportTitlePending = false;
        saveImportCancellationHandoffPending = false;
        error = "セーブ取込はキャンセル済みですが、タイトル起動に失敗しました。既存の保存データは変更していません。";
        saveManagementMessage = error + " " + detail;
        await SetHostStatusAsync("取込キャンセル済み・タイトル起動失敗。既存セーブは変更されていません。",
            busy: false, isError: true);
    }

    async Task ImportGlobal(InputFileChangeEventArgs change)
    {
        const long maxBytes = 16L * 1024 * 1024;
        if (storeModule is null || storeHandle is null || !importMode || !importFormReady || importInProgress)
            return;
        SetDiagnosticStage("file-selected");
        importInProgress = true;
        persistenceState = "validating";
        error = null;
        IBrowserFile file = change.File;
        try
        {
            if (!string.Equals(file.Name, "global.sav", StringComparison.OrdinalIgnoreCase))
            {
                persistenceState = "validation-failed";
                error = "P1C1で選択できるファイルはglobal.savだけです";
                return;
            }
            if (file.Size is <= 0 or > maxBytes)
            {
                persistenceState = "validation-failed";
                error = $"global.savのサイズが不正です（上限{maxBytes} bytes）";
                return;
            }
            string query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
            string profile = QueryValue(query, "profile") ?? "default";
            bool realImport = FixtureKey(query) == "p1c1-real";
            string importRoot = (realImport ? "/p1c1-real-runtime-" : "/p1c1-runtime-") + profile;
            p1c1Root = importRoot;
            using Stream input = file.OpenReadStream(maxBytes);
            using var memory = new MemoryStream((int)file.Size);
            await input.CopyToAsync(memory);
            byte[] bytes = memory.ToArray();
            SetDiagnosticStage("file-read-complete");
            progress = "global.savを検証用Runtimeで検証中です…";
            SetDiagnosticStage("runtime-bootstrap-start");
            session = await BrowserRuntimeSession.StartPersistentBootstrapAsync(importRoot, bytes);
            SetDiagnosticStage("runtime-bootstrap-end");
            SetDiagnosticStage("loadglobal-diagnostic-start");
            GlobalCodecDiagnosticResult diagnostic = session.RunGlobalCodecDiagnostic(resave: false);
            SetDiagnosticStage("loadglobal-diagnostic-end");
            inputSha256 = diagnostic.InputSha256;
            codecValueSha256 = diagnostic.ValueSha256;
            if (!diagnostic.LoadSucceeded)
            {
                session = null;
                persistenceState = "validation-failed";
                error = "既存LoadGlobalが選択ファイルを拒否しました";
                return;
            }
            if (session.Status != BrowserRuntimeStatus.BootstrapReady
                || session.DoScriptCallCount != 0
                || session.PendingPersistenceCount != 0)
                throw new InvalidOperationException("GLOBAL import検証で実行または保存が発生しました");

            SetDiagnosticStage("indexeddb-commit-start");
            StoreCommitResult committed = await storeModule.InvokeAsync<StoreCommitResult>("commit", storeHandle, bytes, "import-" + Guid.NewGuid().ToString("N"), string.Empty);
            SetDiagnosticStage("indexeddb-commit-end");
            revision = committed.Revision;
            durability = committed.Durability;
            loadSource = "file-import";
            persistenceState = "committed";
            p1c1Ready = true;
            progress = "global.savの検証・import完了（タイトル未実行）";
        }
        catch (Exception ex)
        {
            persistenceState = "failed";
            error = "global.sav import失敗: " + ex.Message;
        }
        finally
        {
            importInProgress = false;
        }
    }

