        File.WriteAllBytes(Path.Combine(p1c1Root, "emuera.config"), Encoding.GetEncoding(932).GetBytes(config));
        dataReady = true;
        session = await BrowserRuntimeSession.StartTitleBootstrapAsync(p1c1Root, null);
#if ERB_EXECUTION_PROFILE
