            <form @onsubmit="Submit" @onsubmit:preventDefault>
                <label for="runtime-input">@InputLabel(prompt)</label>
                <input id="runtime-input" data-request-id="@prompt.RequestId" inputmode="@(prompt.Kind == BrowserInputKind.Integer ? "numeric" : "text")" @bind="input" autofocus />
