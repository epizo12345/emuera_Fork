nt" data-resource-animations="@session.Resources.AnimationCount" data-resource-animation-frames="@session.Resources.AnimationFrameCount" data-resource-sha256="@session.Resources.IdentitySha256" data-parent-sha256="@session.Resources.ParentIdentitySha256" data-sprite-sha256="@session.Resources.SpriteIdentitySha256" data-sprite-name-sha256="@session.Resources.SpriteNameSha256" data-nonzero-offsets="@session.Resources.NonZeroOffsetCount" data-width-total="@session.Resources.WidthTotal" data-height-total="@session.Resources.HeightTotal" data-offset-x-total="@session.Resources.OffsetXTotal" data-offset-y-total="@session.Resources.OffsetYTotal" data-source-x-total="@session.Resources.SourceXTotal" data-source-y-total="@session.Resources.SourceYTotal" data-animation-source-x-total="@session.Resources.AnimationSourceXTotal" data-animation-source-y-total="@session.Resources.AnimationSourceYTotal" data-animation-offset-x-total="@session.Resources.AnimationOffsetXTotal" data-animation-offset-y-total="@session.Resources.AnimationOffsetYTotal" data-animation-delay-total="@session.Resources.AnimationDelayTotal">files=@packageFiles resources=@session.Resources.ParentImageCount sprites=@session.Resources.SpriteCount animations=@session.Resources.AnimationCount frames=@session.Resources.AnimationFrameCount</pre>
