    async Task StageActiveImport()
    {
        if (!isP1C3 || isP1C3Integration || isP1C4Small || session is null || storeModule is null || storeHandle is null || importInProgress)
            return;
        importInProgress = true;
        saveManagementMessage = null;
        string? nonce = null;
        try
        {
            await BeginStartupImportProfileAsync("runtime-import-to-title", new { entry = "active-runtime-file-selection" });
            await RecordStartupProfileEventAsync("active-runtime-at-import-start", new
            {
                runtimeInitialized = session is not null,
                saveDataPrepared = dataReady,
                packageCacheHitsBeforeMeasurement = packageCacheHits,
                packageCacheMissesBeforeMeasurement = packageCacheMisses
            });
            await SetSaveImportStatusAsync("ファイルを確認しています…");
            var stageTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            JsonElement stageResult = await storeModule.InvokeAsync<JsonElement>("stageImportFiles", storeHandle,
                "p1c3-active-import", startupImportProfileEnabled);
            await RecordStartupProfilePhaseAsync("cache-stage-import-files", stageTimer);
            if (stageResult.ValueKind == JsonValueKind.Null)
            {
                await FinishStartupImportProfileAsync("file-selection-empty");
                await SetHostStatusAsync(string.Empty, busy: false);
                saveManagementMessage = "ファイル選択を取り消しました。保存済みデータは変更されていません。";
                return;
            }
            if (stageResult.ValueKind == JsonValueKind.String)
                nonce = stageResult.GetString();
            else
            {
                nonce = stageResult.GetProperty("nonce").GetString();
                object[] stagedFiles = stageResult.GetProperty("files").EnumerateArray().Select(file => (object)new
                {
                    logicalFilename = file.GetProperty("name").GetString(),
                    bytes = file.GetProperty("size").GetInt64(),
                    sha256 = (string?)null
                }).ToArray();
                bool persistedGlobalExists = persistedFiles.Any(file => !file.Deleted
                    && string.Equals(file.LogicalFilename, "global.sav", StringComparison.OrdinalIgnoreCase));
                await SetStartupProfileInputFilesAsync(stagedFiles, persistedGlobalExists);
            }
            if (string.IsNullOrEmpty(nonce)) throw new InvalidDataException("取込用一時領域の識別子を取得できません");
            SetSaveImportStage("active-import-file-captured");
            await SetSaveImportStatusAsync("未保存の進行と保存処理を確認しています…");
            var userDecisionTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            bool continueImport = await JS.InvokeAsync<bool>("confirm", "保存ファイルを取得しました。保存管理画面へ移動すると、未保存のゲーム進行は失われます。移動前に確定済みの保存処理を完了します。続けますか？");
            await RecordStartupProfilePhaseAsync("active-import-unsaved-progress-confirmation", userDecisionTimer,
                new { accepted = continueImport }, "user-decision");
            if (!continueImport)
            {
                await storeModule.InvokeVoidAsync("clearStagedImport", nonce);
                nonce = null;
                await FinishStartupImportProfileAsync("active-import-confirmation-cancelled");
                await SetHostStatusAsync(string.Empty, busy: false);
                saveManagementMessage = "セーブ取込を取り消しました。";
                return;
            }
            await SetSaveImportStatusAsync("確定済み保存処理を完了しています…");
            var stopTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            await StopAndDrainForTitleTransition("save-import");
            int pendingAfterDrain = session?.PendingPersistenceCount ?? -1;
            await RecordStartupProfilePhaseAsync("runtime-stop-and-persistence-drain-inclusive", stopTimer,
                new { pendingPersistenceCount = pendingAfterDrain }, "inclusive");
            if (pendingAfterDrain != 0)
                throw new InvalidOperationException("保存処理が完了していません");
            var releaseTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
            bool released = await storeModule.InvokeAsync<bool>("release", storeHandle);
            await RecordStartupProfilePhaseAsync("web-lock-release-before-validation", releaseTimer, new { released });
            if (!released)
                throw new InvalidOperationException("保存領域lockの解放を確認できませんでした");
            storeHandle = null;
            await SetSaveImportStatusAsync("検証用画面を準備しています…");
            await MarkStartupProfileNavigationAsync("runtime-to-save-manager-navigation", new { stagedImport = true });
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["saveManager"] = "1",
                ["stagedImport"] = nonce,
                ["saveImportDone"] = null,
                ["saveImportCancelled"] = null
            }), forceLoad: true, replace: true);
        }
        catch (Exception ex)
        {
            bool stagingCleared = true;
            if (nonce is not null)
            {
                try { stagingCleared = await storeModule.InvokeAsync<bool>("clearStagedImport", nonce); }
                catch { stagingCleared = false; }
            }
            await SetHostStatusAsync("セーブ取込を開始できませんでした。既存の保存済みデータは変更されていません。", busy: false, isError: true);
            saveManagementMessage = "セーブ取込を開始できません: " + ex.Message;
            await FinishStartupImportProfileAsync("active-import-staging-or-handoff-failed");
            if (!stagingCleared)
                saveManagementMessage += " 取込用一時データを消去できませんでした。再読込後に再確認してください。";
        }
        finally { importInProgress = false; }
    }

    async Task CloseSaveManager()
    {
