@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.Text
@using System.Text.Json
@using MinorShift.Emuera.Runtime.Script
@implements IAsyncDisposable

<PageTitle>Emuera WEB</PageTitle>

<main class="@(isP1C3 ? "production-shell" : string.Empty)">
    <h1 class="app-heading">@(isP1C3 ? "ShinEraTenseiP" : isP1C2 ? "Emuera WEB-P1C2" : isP1C1 ? "Emuera WEB-P1C1" : isP1B ? "Emuera WEB-P1B" : "Emuera WEB-P1A")</h1>
        @if (isP1C2)
    {
        <p id="p1c2-status" data-stage="@diagnosticStage" data-data-ready="@dataReady.ToString().ToLowerInvariant()" data-title-ready="@p1c2Ready.ToString().ToLowerInvariant()" data-status="@(session?.Status.ToString().ToLowerInvariant() ?? "starting")" data-persistence="@persistenceState" data-pending-persistence-count="@(session?.PendingPersistenceCount ?? 0)" data-key-macro-enabled="@(session?.KeyMacrosEnabled == true ? "true" : "false")" data-key-macro-ready="@(keyMacrosLoaded && !keyboardTransition && !importInProgress && !macroFileBusy && session is not null ? "true" : "false")" data-load-source="@loadSource" data-revision="@revision" data-pending-kind="@(session?.PendingInput?.Kind.ToString().ToLowerInvariant() ?? "none")" data-request-id="@(session?.PendingInput?.RequestId.ToString() ?? string.Empty)" data-time-limit="@(session?.PendingInput?.TimeLimit ?? -1)" data-timed-input-name="@(session?.PendingInput?.TimedInputName ?? string.Empty)" data-session-generation="@(session?.SessionGeneration ?? 0)" data-display-generation="@(session?.DisplayGeneration ?? 0)" data-twait-timer-state="@twaitTimerState" data-twait-scheduled-request-id="@(scheduledTwaitRequestId?.ToString() ?? string.Empty)" data-twait-scheduled-session-generation="@scheduledTwaitSessionGeneration" data-twait-schedule-count="@twaitScheduleCount" data-twait-callback-count="@twaitCallbackCount" data-primitive-timer-schedule-count="@primitiveTimerScheduleCount" data-primitive-timer-callback-count="@primitiveTimerCallbackCount" data-run-root="@p1c1Root" data-display-lines="@(session?.DisplayLines.Count ?? 0)" data-display-images="@DisplayDiagnosticCount(BrowserDisplayPartKind.Image)" data-display-buttons="@DisplayDiagnosticCount(BrowserDisplayPartKind.Button)" data-diagnostic-continuation="@diagnosticContinuation.ToString().ToLowerInvariant()" data-diagnostic-warning-limit="@BrowserInfiniteLoopContinuation.WarningLimit" data-diagnostic-elapsed-limit-ms="@BrowserInfiniteLoopContinuation.ElapsedLimitMilliseconds" data-diagnostic-warning-count="@(session?.InfiniteLoopContinuation?.WarningCount ?? 0)" data-diagnostic-elapsed-ms="@(session?.InfiniteLoopContinuation?.ElapsedMilliseconds ?? 0)" data-diagnostic-erb-position="@(session?.InfiniteLoopContinuation?.Events.LastOrDefault()?.ErbPosition ?? string.Empty)" data-long-running-mode="@(diagnosticContinuation ? "diagnostic" : "interactive")" data-long-running-event-count="@(session?.LongRunningPrompt?.Events.Count ?? 0)" data-long-running-reason="@(session?.LongRunningPrompt?.Events.LastOrDefault()?.Reason ?? string.Empty)" data-message-skip-active="@(session?.MessageSkip.Active.ToString().ToLowerInvariant() ?? "false")" data-message-skip-operation="@(session?.MessageSkip.OperationId ?? 0)" data-message-skip-continuations="@(session?.MessageSkip.Continuations ?? 0)" data-message-skip-reason="@(session?.MessageSkip.StopReason ?? string.Empty)" data-macro-active="@macroActive.ToString().ToLowerInvariant()" data-macro-pending-count="@(macroQueue?.Count ?? 0)" data-macro-total-token-count="@macroTotalTokenCount" data-macro-consumed-token-count="@macroConsumedTokenCount" data-doscript-count="@(session?.DoScriptCallCount ?? 0)" data-doscript-ms="@(session?.DoScriptElapsedMilliseconds ?? 0)" data-managed-memory-bytes="@(perfGate01b ? session?.CurrentManagedMemoryBytes ?? 0 : (long?)null)" data-output-length="@(session?.OutputLength ?? 0)" data-island-lines="@(session?.IslandLineCount ?? 0)" data-gc-collections="@(perfGate01b ? string.Join(",", Enumerable.Range(0, GC.MaxGeneration + 1).Select(GC.CollectionCount)) : null)" data-display-projection-count="@(session?.DisplayProjectionCount ?? 0)" data-erb-position="@(session?.CurrentErbPosition ?? string.Empty)" data-save-import-selected-count="@saveImportSelectedCount" data-save-import-bytes-read="@saveImportBytesRead">@progress</p>
        <pre id="save-import-trace" hidden>@JsonSerializer.Serialize(saveImportTrace)</pre>
        <p id="package-cache-metrics" hidden data-state="@packageCacheState" data-hits="@packageCacheHits" data-misses="@packageCacheMisses" data-recovered-packs="@packageCacheRecoveredPacks" data-cleaned-packs="@packageCacheCleanedPacks" data-persisted="@packageCachePersistent.ToString().ToLowerInvariant()" data-usage="@packageCacheUsage" data-quota="@packageCacheQuota" data-network-bytes="@transferBytes" data-download-ms="@downloadMilliseconds" data-extract-ms="@extractMilliseconds" data-extracted-bytes="@extractedBytes" data-package-lookups="@packageLookups"></p>
        @if (warmStartupProfile)
        {
            <pre id="warm-startup-metrics" hidden>@JsonSerializer.Serialize(new { phases = startupPhases, durations = startupDurations, runtime = session is null ? null : new { configMs = session.ConfigLoadMilliseconds, preloadMs = session.PreloadMilliseconds, processInitializeMs = session.ProcessInitializeMilliseconds, bootstrapMs = session.BootstrapElapsedMilliseconds, titleDoScriptMs = session.DoScriptElapsedMilliseconds }, processInitialize = session?.ProcessInitializeProfile })</pre>
        }
        @if (startupImportProfileEnabled)
        {
            <pre id="startup-import-profile-json" data-warning="@startupImportProfileWarning" hidden>@startupImportProfileJson</pre>
        }
        @if (error is not null)
        {
            <p class="error" role="alert" data-p1c2-error>@error</p>
            @if (runtimeFailureDiagnostic is not null)
            {
                <details id="runtime-failure-diagnostic">
                    <summary>実行診断情報</summary>
                    <pre>@JsonSerializer.Serialize(runtimeFailureDiagnostic)</pre>
                </details>
            }
            @if (startupErrorDetails is not null)
            {
                <details id="startup-error-diagnostic">
                    <summary>起動診断情報</summary>
                    <pre>@startupErrorDetails</pre>
                </details>
            }
        }
        @if (isP1C3 && !isP1C3Integration && !isP1C4Small)
        {
            <section id="host-toolbar" class="host-toolbar" aria-label="ゲーム操作">
                <span class="host-title">ShinEraTenseiP</span>
                <span id="host-status" class="host-status @(hostStatusBusy ? "is-busy" : hostStatusError ? "is-error" : "is-idle")" role="status" aria-live="polite" title="@hostStatus" hidden="@string.IsNullOrEmpty(hostStatus)">
                    @if (hostStatusBusy)
                    {
                        <span class="host-status-spinner" aria-hidden="true"></span>
                    }
                    <span class="host-status-text">@hostStatus</span>
                    @if (hostStatusBusy)
                    {
                        <span class="host-status-progress" aria-hidden="true"></span>
                    }
                </span>
                <span class="host-macro-control" aria-live="polite">
                    @if (macroActive)
                    {
                        <button id="host-macro-stop" class="host-macro-stop" type="button" @onclick="StopHostMacro" @onclick:stopPropagation @onmousedown:stopPropagation>マクロ停止</button>
                    }
                    else if (session?.MessageSkip.Active == true)
                    {
                        <button id="host-message-skip-stop" type="button" @onclick="StopMessageSkip" @onclick:stopPropagation @onmousedown:stopPropagation>送りを停止</button>
                    }
                </span>
                <details id="host-key-macros" class="host-key-macros" @onkeydown:stopPropagation @onmousedown:stopPropagation @onclick:stopPropagation>
                    <summary>マクロ操作</summary>
                    <div class="host-key-macros-panel">
                        <button type="button" @onclick="CloseKeyMacroPanel">閉じる</button>
                        <label>グループ <select id="key-macro-group" value="@keyMacros.Group" disabled="@(!CanUseKeyMacros)" @onchange="ChangeKeyMacroGroup">
                            @for (int g = 0; g < 10; g++) { <option value="@g">@(g): @keyMacros.GroupNames[g]</option> }
                        </select></label>
                        <p>F1～F12で呼出、Shift＋Fで登録、Ctrl＋数字でグループ切替。ブラウザがキーを使う場合は下のボタンを使えます。</p>
                        <label for="key-macro-draft">入力欄の内容（登録する文字列）</label>
                        <textarea id="key-macro-draft" rows="2" @bind="input" @bind:event="oninput"></textarea>
                        <p>空欄の登録は既存スロットを変更しません。通常INPUTでは呼出後にEnterで実行します。ONEINPUT／AnyKeyでは実機同様、文字数が増える呼出が入力へ進む場合があります。</p>
                        @if (session?.PendingInput?.Kind == BrowserInputKind.MouseKey) { <p>キー入力待ち中はFキーもゲームへ送ります。マクロ呼出・登録は通常入力に戻ってから使えます。</p> }
                        <div class="key-macro-slots">
                            @for (int f = 0; f < 12; f++)
                            {
                                int slot = f;
                                <div class="key-macro-slot" data-slot="@slot">
                                    <span>F@(slot + 1)</span><code title="@keyMacros.Get(slot)">@(keyMacros.Get(slot).Length == 0 ? "（空）" : keyMacros.Get(slot))</code>
                                    <button type="button" data-macro-action="recall" disabled="@(!CanRecallKeyMacros)" @onclick='() => ApplyKeyMacro("recall", slot)'>呼出</button>
                                    <button type="button" data-macro-action="register" disabled="@(!CanRecallKeyMacros)" @onclick='() => ApplyKeyMacro("register", slot)'>登録</button>
                                </div>
                            }
                        </div>
                        <fieldset disabled="@(!CanTransferMacroFile)">
                            <legend>実機と共通のmacro.txt（セーブとは別）</legend>
                            <label>macro.txtを読み込む <InputFile id="key-macro-file" OnChange="PreviewMacroFile" accept=".txt" /></label>
                            <button id="key-macro-export" type="button" @onclick="ExportMacroFile">macro.txtを書き出す（CP932）</button>
                        </fieldset>
                        @if (macroFilePreview is not null)
                        {
                            <p>読み込み文字コード: @macroFilePreview.EncodingName。@macroFilePreview.DefinedSlots / 120スロットの定義。現在の全10グループ・120スロットを置き換えます。ファイルにないスロットは空欄、グループ名は実機の初期名になります。選択中グループは維持します。マクロは実行しません。</p>
                            <pre id="key-macro-file-preview">@MacroPreviewText()</pre>
                            <button id="key-macro-import-confirm" disabled="@(!CanTransferMacroFile)" type="button" @onclick="ConfirmMacroFile">確認して全体を置換</button>
                            <button id="key-macro-import-cancel" disabled="@macroFileBusy" type="button" @onclick="CancelMacroFile">キャンセル</button>
                        }
                        <p id="key-macro-message" role="status">@keyMacroMessage</p>
                    </div>
                </details>
                <button id="return-title" type="button" disabled="@(importInProgress || keyboardTransition || titleBootstrapInProgress || (session is null && !saveManagerMode))" @onclick="ReturnToTitle">タイトルに戻る</button>
                <details id="p1c3-save-manager" class="save-manager">
                    <summary>セーブ管理</summary>
                    <div class="save-manager-panel">
                    <button id="close-save-panel" type="button" disabled="@importInProgress" @onclick="CloseSavePanel">閉じる</button>
                    @if (!saveManagerMode && !saveImportReadProbe)
                    {
                        <p>保存済みデータの一覧です。実行中Runtimeの未保存状態は含まれません。</p>
                        <p>PCからの取込では安全な検証のためゲームを停止して再読込します。未保存の進行は失われます。選択後に確認します。</p>
                        <label for="p1c3-active-import">PCからセーブを取り込む</label>
                        <input id="p1c3-active-import" type="file" multiple disabled="@importInProgress" accept=".sav,application/octet-stream" @onchange="StageActiveImport" />
                    }
                    else
                    {
                    <p>保存済みデータの一覧です。実行中Runtimeの未保存状態は含まれません。</p>
                    <label for="p1c3-import">PCからセーブを取り込む</label>
                    <InputFile id="p1c3-import" multiple disabled="@importInProgress" accept=".sav,application/octet-stream" OnChange="ImportP1C3Files" />
                    }
                    @if (importInProgress)
                    {
                        <p id="p1c2-import-busy" aria-live="polite">@hostStatus</p>
                    }
                    @if (!string.IsNullOrEmpty(saveManagementMessage))
                    {
                        <p id="save-management-result" aria-live="polite">@saveManagementMessage</p>
                    }
                    <ul id="p1c3-files" data-file-count="@persistedFiles.Count">
                        @foreach (StorePreparedFile file in persistedFiles.Where(file => !file.Deleted))
                        {
                            <li data-save-name="@file.LogicalFilename" data-save-revision="@file.Revision" data-save-size="@(file.Bytes?.Length ?? 0)">
                                @file.LogicalFilename (@(file.Bytes?.Length ?? 0) bytes)
                                <button type="button" disabled="@importInProgress" @onclick="() => ExportSave(file.LogicalFilename)">書き出し</button>
                            </li>
                        }
                    </ul>
                    </div>
                </details>
            </section>
        }
        else if (importMode && importFormReady && session is null && error is null && !importInProgress)
        {
            <label for="p1c2-import">global.savを選択</label>
            <InputFile id="p1c2-import" accept=".sav,application/octet-stream" OnChange="ImportP1C2Global" />
        }
        else if (importInProgress)
        {
            <p id="p1c2-import-busy" aria-live="polite">global.savを検証して保存中です…</p>
        }
        @if (isP1C3 && (isP1C3Integration || isP1C4Small))
        {
            <ul id="p1c3-files" data-file-count="@persistedFiles.Count">
                @foreach (StorePreparedFile file in persistedFiles.Where(file => !file.Deleted))
                {
                    <li data-save-name="@file.LogicalFilename" data-save-revision="@file.Revision" data-save-size="@(file.Bytes?.Length ?? 0)">
                        @file.LogicalFilename (@(file.Bytes?.Length ?? 0) bytes)
                        <button type="button" disabled="@importInProgress" @onclick="() => ExportSave(file.LogicalFilename)">書き出し</button>
                    </li>
                }
            </ul>
        }
        @if (stateDiagnostic is not null)
        {
            <pre id="p1c4-state-diagnostic" data-read-only="true" data-doscript-count="@(session?.DoScriptCallCount ?? -1)" data-pending-persistence="@(session?.PendingPersistenceCount ?? -1)">@JsonSerializer.Serialize(stateDiagnostic)</pre>
        }
        @if (session?.PersistenceAckTimeline.Count > 0)
        {
            <pre id="persistence-ack-timeline" hidden>@JsonSerializer.Serialize(session.PersistenceAckTimeline)</pre>
        }
        @if (isP1C3Integration)
        {
            <p id="p1c3-r1-state" data-stage="@diagnosticStage" data-action="@integrationAction" data-count="@integrationCount" data-status="@(session?.Status.ToString().ToLowerInvariant() ?? "starting")" data-file-count="@persistedFiles.Count(file => !file.Deleted)" data-runtime-file-count="@IntegrationRuntimeFileCount()"></p>
            <pre id="p1c3-r1-files">@JsonSerializer.Serialize(IntegrationPersistedSnapshot())</pre>
            <pre id="p1c3-r1-runtime-files">@JsonSerializer.Serialize(IntegrationRuntimeSnapshot())</pre>
            <pre id="runtime-output">@session?.Output</pre>
        }
        else if (isP1C5 && isP1C4Real && session is not null)
        {
            string tail = session.OutputTail(262144);
            <pre id="p1c5-output-tail" data-output-start="@(session.OutputLength - tail.Length)" data-output-end="@session.OutputLength">@tail</pre>
            <pre id="p1c5-persistence-diagnostics" hidden>@JsonSerializer.Serialize(session.PersistenceDiagnostics)</pre>
        }
        @if (perfGate01b && session is not null)
        {
            <pre id="perf-gate-01b-display-metrics" hidden>@JsonSerializer.Serialize(session.DisplayPerformance)</pre>
            <pre id="ux16r3-render-metrics" hidden>@JsonSerializer.Serialize(new { animationRenderRequests, hiddenCountCalls, hiddenCountElapsedTicks })</pre>
        }
        else if (isP1C4Small || (isP1C4Real && diagnosticOutput))
        {
            <pre id="runtime-output">@session?.Output</pre>
        }
        <div id="game-fit-viewport" class="game-fit-viewport">
        <div id="game-fit-slot" class="game-fit-slot">
        <div class="game-frame">
        <div id="game-surface" class="game-surface" data-tooltip-delay="@(session?.TooltipDelayMilliseconds ?? 500)" data-tooltip-duration="@(session?.TooltipDurationMilliseconds ?? 0)" data-tooltip-foreground="@(session?.TooltipForeground ?? "#000000")" data-tooltip-background="@(session?.TooltipBackground ?? "#FFFFFF")">
        <div id="game-screen" class="@(IsDisplayWindowMode ? "game-windowed" : string.Empty)" style="background-color:@(session?.BackgroundColor ?? "#000000")" tabindex="0" data-display-structure-generation="@(session?.DisplayStructureGeneration ?? 0)" data-one-input="@(session?.PendingInput is { Kind: BrowserInputKind.String or BrowserInputKind.Integer, OneInput: true } ? "true" : "false")" data-tooltip-delay="@(session?.TooltipDelayMilliseconds ?? 500)" data-tooltip-duration="@(session?.TooltipDurationMilliseconds ?? 0)" data-tooltip-foreground="@(session?.TooltipForeground ?? "#000000")" data-tooltip-background="@(session?.TooltipBackground ?? "#FFFFFF")" @onkeydown="SubmitPrimitiveKey" @onkeyup="KeyReleaseHandler" @onblur="ResetPrimitiveKeys" @onmousedown="SubmitPrimitivePointer" @onclick="SubmitGameAreaClick" @oncontextmenu:preventDefault>
        @if (session is not null)
        {
#if ERB_EXECUTION_PROFILE
            TraceGameplayStage("razor-begin");
#endif
            <div class="game-log-lines" style="--game-line-height:@(session.DisplayLineHeight)px;padding-left:@(session.DrawingPositionShift)px;">
            @if (IsDisplayWindowMode)
            {
                BrowserDisplayWindowSlice slice = displayWindow.Calculate(session.RetainedDisplayLines, session.RetainedDisplayLines.Count - session.IslandLineCount, session.DisplayStructureGeneration, session.DisplayLineHeight);
                animationFirstLine = slice.Start;
                animationEndLine = slice.End;
                <div class="game-window-spacer" aria-hidden="true" style="@SpacerStyle(slice.TopSpacerPx)"></div>
                @for (int lineIndex = slice.Start; lineIndex < slice.End; lineIndex++)
                {
                    BrowserDisplayLine line = session.DisplayLines[lineIndex];
                    bool nativeLinePainted = slice.IsNativeLinePainted(lineIndex);
                    <div @key="line.LineId" class="game-line align-@line.Alignment" data-line-id="@line.LineId">
                        @foreach (BrowserDisplayPart part in line.Parts)
                        {
                            <BrowserPartView Part="part" OnMouseDown="SubmitDisplay" NativeLinePainted="nativeLinePainted" />
                        }
                    </div>
                }
                <div class="game-window-spacer" aria-hidden="true" style="@SpacerStyle(slice.BottomSpacerPx)"></div>
            }
            else
            {
                @foreach (BrowserDisplayLine line in session.DisplayLines.Take(session.DisplayLines.Count - session.IslandLineCount))
                {
                    <div class="game-line align-@line.Alignment">
                        @foreach (BrowserDisplayPart part in line.Parts)
                        {
                            <BrowserPartView Part="part" OnMouseDown="SubmitDisplay" />
                        }
                    </div>
                }
            }
            </div>
#if ERB_EXECUTION_PROFILE
            TraceGameplayStage("razor-end");
#endif
        }
        </div>
        @if (session is { IslandLineCount: > 0 })
        {
            <div id="game-island-layer" class="game-island-layer" @onmousedown="SubmitPrimitivePointer" @onclick="SubmitIslandAreaClick" @oncontextmenu:preventDefault>
                @for (int lineIndex = session.DisplayLines.Count - session.IslandLineCount; lineIndex < session.DisplayLines.Count; lineIndex++)
                {
                    BrowserDisplayLine line = session.DisplayLines[lineIndex];
                    <div @key="line.LineId" class="game-line align-@line.Alignment" data-line-id="@line.LineId">
                        @foreach (BrowserDisplayPart part in line.Parts)
                        {
                            <BrowserPartView Part="part" OnMouseDown="SubmitDisplay" FlowOffsetY="line.IslandFlowOffsetY" />
                        }
                    </div>
                }
            </div>
        }
        </div>
        <div class="game-input-slot">
        @if (isP1C3 && !isP1C3Integration && !isP1C4Small
            && session?.PendingInput is BrowserInputPrompt valuePrompt
            && (valuePrompt.Kind == BrowserInputKind.Integer || valuePrompt.Kind == BrowserInputKind.String)
            && (!valuePrompt.OneInput || (valuePrompt.Kind == BrowserInputKind.String
                && valuePrompt.TimeLimit <= 0 && string.IsNullOrEmpty(valuePrompt.TimedInputName))))
        {
            <form class="game-input-form" @onsubmit="SubmitP1C2Form" @onsubmit:preventDefault>
                <label class="game-input-label" for="runtime-input">@InputLabel(valuePrompt)@(valuePrompt.OneInput ? "（操作マクロ可）" : string.Empty)</label>
                <input @key="valuePrompt.RequestId" id="runtime-input" type="text" data-request-id="@valuePrompt.RequestId" data-one-input="@valuePrompt.OneInput.ToString().ToLowerInvariant()" inputmode="@(valuePrompt.Kind == BrowserInputKind.Integer ? "numeric" : "text")" @bind="input" @bind:event="oninput" autocomplete="off" />
                <button id="runtime-submit" type="submit" aria-label="入力を確定">↵</button>
            </form>
        }
        </div>
        </div>
        </div>
        </div>
        @if (IsDisplayWindowMode && session is not null)
        {
            BrowserDisplayWindowSlice diagnosticSlice = displayWindow.Calculate(session.RetainedDisplayLines, session.RetainedDisplayLines.Count - session.IslandLineCount, session.DisplayStructureGeneration, session.DisplayLineHeight);
            <p id="perf-gate-01c-window" hidden data-dom-window-mode="@domWindowMode" data-retained-lines="@session.DisplayLines.Count" data-rendered-lines="@(diagnosticSlice.End - diagnosticSlice.Start)" data-window-start="@diagnosticSlice.Start" data-window-end="@diagnosticSlice.End" data-native-paint-start="@diagnosticSlice.NativePaintStart" data-native-paint-end="@diagnosticSlice.NativePaintEnd" data-top-spacer="@diagnosticSlice.TopSpacerPx" data-bottom-spacer="@diagnosticSlice.BottomSpacerPx" data-follow-tail="@diagnosticSlice.FollowTail.ToString().ToLowerInvariant()" data-measurement-cache="@displayWindow.MeasurementCount" data-scroll-count="@displayWindowScrollCount" data-measure-count="@displayWindowMeasureCount" data-recalculate-count="@displayWindowRecalculateCount" data-correction-count="@displayWindowCorrectionCount" data-correction-limit-count="@displayWindowCorrectionLimitCount"></p>
        }
        @if (session is not null && (!isP1C3 || isP1C3Integration || isP1C4Small))
        {
            @if (session.MessageSkip.Active)
            {
                <button id="message-skip-stop" type="button" @onclick="StopMessageSkip">送りを停止</button>
            }
            @if (session.PendingInput is { Kind: not BrowserInputKind.MouseKey and not BrowserInputKind.TimedVoid } prompt)
            {
                @if (prompt.Kind is BrowserInputKind.Enter or BrowserInputKind.AnyKey)
                {
                    <section id="runtime-continue" class="runtime-continue">
                        <span>画面内を左クリックして進む（Enterキーも可）</span>
                        <button id="runtime-submit" type="button" @onclick="SubmitP1C2Text">進む</button>
                        @if (!prompt.StopMessageSkip)
                        {
                            <button id="message-skip-start" type="button" @onclick="StartMessageSkip">まとめて送る</button>
                        }
                    </section>
                }
                else
                {
                    <form @onsubmit="SubmitP1C2Form" @onsubmit:preventDefault>
                        <label for="runtime-input">@InputLabel(prompt)</label>
                        <input id="runtime-input" data-request-id="@prompt.RequestId" inputmode="@(prompt.Kind == BrowserInputKind.Integer ? "numeric" : "text")" @bind="input" @bind:event="oninput" autofocus />
                        @if (prompt.TimeLimit > 0 && prompt.DisplayTime)
                        {
                            <span id="timed-input-remaining" data-request-id="@prompt.RequestId" aria-live="off">残り @((prompt.TimeLimit / 1000.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)) 秒</span>
                        }
                        <button id="runtime-submit" type="submit">入力</button>
                        <button id="runtime-submit-skip" type="button" @onclick="SubmitP1C2TextWithSkip">入力＋スキップ</button>
                    </form>
                }
            }
            else if (session.PendingInput is { Kind: BrowserInputKind.MouseKey })
            {
                <p id="mousekey-wait" aria-live="polite">クリックまたはキー入力待ち</p>
            }
            else if (session.PendingInput is { Kind: BrowserInputKind.TimedVoid } timedVoid)
            {
                <p id="timed-void-wait" data-request-id="@timedVoid.RequestId" data-time-limit="@timedVoid.TimeLimit" aria-live="polite">時間待ち</p>
            }
        }
    }
    else if (isP1C1)
    {
