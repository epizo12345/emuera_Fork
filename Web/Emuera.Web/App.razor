    void ReleasePrimitiveKey(KeyboardEventArgs keyboard)
    {
        keyboardInput.KeyUp(keyboard.Code);
        BrowserKeyInput? mapped = BrowserInputMapping.MapKey(keyboard.Code, keyboard.Key, keyboard.CtrlKey, keyboard.ShiftKey, keyboard.AltKey);
        session?.SetKeyState(mapped?.Code ?? 0, false);
        if (keyboard.Code == acceptedPrimitiveModifier) acceptedPrimitiveModifier = null;
    }

