    async Task StartP1C3Title(IReadOnlyDictionary<string, byte[]> files)
    {
        if (!dataReady || storeModule is null || storeHandle is null)
            throw new InvalidOperationException("実データ準備前にはタイトルを開始できません");
        // AOT cannot safely hold the outgoing real-data Runtime while a replacement bootstrap allocates images.
        // StopAndDrainForTitleTransition has already made its persistence boundary safe for every replacement path.
        bool replacing = session is not null;
        displayWindowSession = null;
        session = null;
        await Task.Yield();
        var outgoingReleaseTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
        if (replacing)
        {
            BrowserRuntimeSession.ReleaseBootstrapResources();
            // The replacement bootstrap allocates another full real-data graph before AOT GC would reclaim the old one.
            _ = GC.GetTotalMemory(forceFullCollection: true);
        }
        await RecordStartupProfilePhaseAsync("outgoing-runtime-release-and-existing-gc", outgoingReleaseTimer,
            new { replacingRuntime = replacing, forcedCollection = replacing });
        progress = "実SYSTEM_TITLEを実行中です…";
        await SetHostStatusAsync("起動中：ゲームを初期化しています…");
        SetDiagnosticStage("runtime-bootstrap-start");
        var runtimeBootstrapTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
        session = await BrowserRuntimeSession.StartSavePersistentBootstrapAsync(p1c1Root, files,
            captureProcessInitializeProfile: startupImportProfileEnabled);
        await RecordStartupProfilePhaseAsync("title-runtime-bootstrap-inclusive", runtimeBootstrapTimer, new
        {
            session.ConfigLoadMilliseconds,
            session.PreloadMilliseconds,
            session.ProcessInitializeMilliseconds,
            session.BootstrapElapsedMilliseconds,
            processInitialize = session.ProcessInitializeProfile
        }, "inclusive");
#if ERB_EXECUTION_PROFILE
        if (QueryValue(new Uri(Navigation.Uri).Query, "ux16r5Trace") == "1") session.GameplayTrace = TraceGameplayStage;
#endif
        if (perfGate01b)
            session.EnableDisplayPerformanceMetrics();
        session.EnableInteractiveInfiniteLoopPrompt(ConfirmLongRunning);
        SetDiagnosticStage("runtime-bootstrap-end");
        ViewportResult viewport = await storeModule.InvokeAsync<ViewportResult>("measureElement", "game-screen");
        if (viewport.Width <= 0 || viewport.Height <= 0)
            throw new InvalidOperationException("ゲーム画面の実寸を取得できません");
        ConfigureTextMeasurement();
        session.SetViewport(viewport.Width, viewport.Height);
        await SetHostStatusAsync("起動中：タイトルを準備しています…");
        SetDiagnosticStage("title-script-start");
        titleBootstrapInProgress = true;
        var titleScriptTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
        session.StartTitle();
        await RecordStartupProfilePhaseAsync("title-script-execution", titleScriptTimer,
            new { calls = session.DoScriptCallCount, elapsedDoScriptMilliseconds = session.DoScriptElapsedMilliseconds }, "inclusive");
        if (captureR3R3RawHtml)
            session.EnableR3R3RawHtmlCapture();
        SetDiagnosticStage("title-script-end");
        var inputReadyTimer = startupImportProfileEnabled ? System.Diagnostics.Stopwatch.StartNew() : null;
        await AdvanceP1C2();
        await RecordStartupProfilePhaseAsync("title-input-ready-state-transition", inputReadyTimer,
            new { titleInputReady = p1c2Ready, physicalPaintGuaranteed = false });
        await SaveStartupProfilePageSummaryAsync();
    }

