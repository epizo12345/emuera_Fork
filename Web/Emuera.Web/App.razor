        session = await BrowserRuntimeSession.StartTitleBootstrapAsync(p1c1Root, globalBytes, captureProcessInitializeProfile: warmStartupProfile);
        if (diagnosticContinuation)
            session.EnableDiagnosticInfiniteLoopContinuation();
