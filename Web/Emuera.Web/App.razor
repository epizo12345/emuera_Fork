    Dictionary<string, byte[]> CurrentSaveFiles() => persistedFiles
        .Where(file => !file.Deleted && file.Bytes is not null)
        .ToDictionary(file => file.LogicalFilename, file => file.Bytes!, StringComparer.OrdinalIgnoreCase);

    Dictionary<string, object> IntegrationPersistedSnapshot() => persistedFiles
        .OrderBy(file => file.LogicalFilename, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(file => file.LogicalFilename, file => (object)new
        {
            sha256 = file.Bytes is null ? string.Empty : Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(file.Bytes)).ToLowerInvariant(),
            byteLength = file.Bytes?.Length ?? 0,
            revision = file.Revision,
            deleted = file.Deleted,
            lastOperationId = file.LastOperationId
        }, StringComparer.OrdinalIgnoreCase);

    Dictionary<string, object> IntegrationRuntimeSnapshot()
    {
        string root = p1c1Root;
        if (!Directory.Exists(root)) return new(StringComparer.OrdinalIgnoreCase);
        return Directory.GetFiles(root, "*.sav", SearchOption.AllDirectories)
            .OrderBy(path => Path.GetFileName(path), StringComparer.OrdinalIgnoreCase)
            .ToDictionary(path => Path.GetFileName(path), path =>
            {
                byte[] bytes = File.ReadAllBytes(path);
                return (object)new
                {
                    sha256 = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(bytes)).ToLowerInvariant(),
                    byteLength = bytes.Length
                };
            }, StringComparer.OrdinalIgnoreCase);
    }

    int IntegrationRuntimeFileCount() => string.IsNullOrEmpty(p1c1Root) || !Directory.Exists(p1c1Root)
        ? 0 : Directory.GetFiles(p1c1Root, "*.sav", SearchOption.AllDirectories).Length;

    static string NormalizeImportedSaveFilename(string value)
    {
        if (string.Equals(value, "global.sav", StringComparison.OrdinalIgnoreCase)) return "global.sav";
        if (!value.StartsWith("save", StringComparison.OrdinalIgnoreCase) || !value.EndsWith(".sav", StringComparison.OrdinalIgnoreCase))
            throw new InvalidDataException($"保存ファイル名が不正です: {value}");
        string digits = value[4..^4];
        if (!int.TryParse(digits, out int slot) || slot < 0)
            throw new InvalidDataException($"保存番号が不正です: {value}");
        string normalized = $"save{slot:00}.sav";
        if (!string.Equals(value, normalized, StringComparison.OrdinalIgnoreCase))
            throw new InvalidDataException($"非canonicalな保存ファイル名です: {value}");
        return normalized;
    }

    static int ParseSaveSlot(string value)
    {
        string normalized = NormalizeImportedSaveFilename(value);
        if (normalized == "global.sav") throw new InvalidDataException("GLOBALには通常保存番号がありません");
        return int.Parse(normalized[4..^4], System.Globalization.CultureInfo.InvariantCulture);
    }

    async Task<StoreCommitResult> CommitMutation(SaveMutation request, string fault)
    {
        if (storeModule is null || storeHandle is null)
            throw new InvalidOperationException("保存領域が準備されていません");
        StoreMutationBatchResult batch = await storeModule.InvokeAsync<StoreMutationBatchResult>(
            "commitMutations", storeHandle, new[] { request }, fault);
        StoreMutationResult file = batch.Files.Single();
        UpsertPersisted(file, request.Bytes);
        return new() { Revision = file.Revision, Durability = batch.Durability };
    }

    void UpsertPersisted(StoreMutationResult result, byte[]? bytes)
    {
        persistedFiles.RemoveAll(file => string.Equals(file.LogicalFilename, result.LogicalFilename, StringComparison.OrdinalIgnoreCase));
        persistedFiles.Add(new()
        {
            LogicalFilename = result.LogicalFilename,
            Deleted = result.Deleted,
            Bytes = result.Deleted ? null : bytes,
            Revision = result.Revision,
            LastOperationId = result.LastOperationId
        });
        if (result.LogicalFilename == "global.sav") revision = result.Revision;
    }

    async Task StartP1B()
    {
        const string root = "/p1b-runtime";
        await InstallP1BData(root);
        Directory.CreateDirectory(Path.Combine(root, "sav"));
        progress = "実設定・CSV・ERH・ERB・resourcesを初期化中です…";
        session = await BrowserRuntimeSession.StartBootstrapAsync(root);
        if (session.Status != BrowserRuntimeStatus.BootstrapReady || session.DoScriptCallCount != 0)
            throw new InvalidOperationException($"BootstrapReadyへ到達していません: {session.Status}, DoScript={session.DoScriptCallCount}");
    }

    async Task PrepareP1C1Data(string root, bool real, string fixtureCase)
    {
        if (real)
        {
            string csv = Directory.Exists(Path.Combine(root, "CSV")) ? Path.Combine(root, "CSV") : Path.Combine(root, "csv");
            if (!Directory.Exists(csv) || !Directory.EnumerateFiles(csv).Any(path => string.Equals(Path.GetFileName(path), "GAMEBASE.CSV", StringComparison.OrdinalIgnoreCase)))
                await InstallP1BData(root);
            return;
        }
        foreach ((string source, string destination) in new[]
        {
            ("p1c1-fixture/CSV/GAMEBASE.CSV", "CSV/GAMEBASE.CSV"),
            ("p1c1-fixture/ERB/P1C1.ERH", "ERB/P1C1.ERH"),
            (fixtureCase == "overwrite" ? "p1c1-fixture/ERB/OVERWRITE.ERB" : "p1c1-fixture/ERB/P1C1.ERB", "ERB/P1C1.ERB")
        })
        {
            string destinationPath = Path.Combine(root, destination.Replace('/', Path.DirectorySeparatorChar));
            Directory.CreateDirectory(Path.GetDirectoryName(destinationPath)!);
            File.WriteAllBytes(destinationPath, await Http.GetByteArrayAsync(source));
        }
        Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
        File.WriteAllBytes(Path.Combine(root, "emuera.config"), Encoding.GetEncoding(932).GetBytes("セーブデータをバイナリ形式で保存する:YES"));
    }

    async Task InstallP1BData(string root)
    {
        long allocationStart = startupImportProfileEnabled ? GC.GetTotalAllocatedBytes() : 0;
        dataPrepPackBreakdown = dataPrepBreakdownEnabled ? new() : null;
        httpRequests = 0;
        packageFiles = 0;
        transferBytes = 0;
        downloadMilliseconds = 0;
        extractMilliseconds = 0;
        extractedBytes = 0;
        packageLookups = 0;
        packageCacheHits = 0;
        packageCacheMisses = 0;
        packageCacheRecoveredPacks = 0;
        packageCacheCleanedPacks = 0;
        packageCacheUsage = -1;
        packageCacheQuota = -1;
        packageCachePersistent = true;
        packageCacheState = "preparing";
        string downloads = root + "-downloads";
        var jsonOptions = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        progress = "manifestを取得中です…";
        var manifestFetch = System.Diagnostics.Stopwatch.StartNew();
        string manifestJson = await Http.GetStringAsync("p1b-data/manifest.json");
        AddStartupDuration("manifestFetch", manifestFetch.ElapsedMilliseconds);
        var manifestDeserialize = warmStartupProfile ? System.Diagnostics.Stopwatch.StartNew() : null;
        DataPackageManifest manifest = JsonSerializer.Deserialize<DataPackageManifest>(manifestJson, jsonOptions)
            ?? throw new InvalidDataException("manifest.jsonを読めません");
        if (manifestDeserialize is not null) AddStartupDuration("manifestDeserialize", manifestDeserialize.ElapsedMilliseconds);
        httpRequests++;
        transferBytes += Encoding.UTF8.GetByteCount(manifestJson);
        packageFiles = manifest.Files.Count;
        progress = "manifestを検証中です…";
        var manifestValidation = System.Diagnostics.Stopwatch.StartNew();
        DataPackageIndex packageIndex = DataPackageExtractor.Validate(manifest, manifest.TotalSize);
        AddStartupDuration("manifestValidation", manifestValidation.ElapsedMilliseconds);
        var cacheModuleImport = System.Diagnostics.Stopwatch.StartNew();
        packageCacheModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./package-cache.js");
        AddStartupDuration("packageCacheModuleImport", cacheModuleImport.ElapsedMilliseconds);
        Directory.CreateDirectory(root);
        Directory.CreateDirectory(downloads);

        foreach (string pack in manifest.Files.Select(file => file.Pack).Distinct(StringComparer.Ordinal))
        {
            var identityTimer = warmStartupProfile ? System.Diagnostics.Stopwatch.StartNew() : null;
            string identity = PackageIdentity(manifest, pack);
            if (identityTimer is not null) AddStartupDuration("packageIdentity", identityTimer.ElapsedMilliseconds);
            string archivePath = Path.Combine(downloads, pack);
            bool extracted = false;
            for (int attempt = 0; attempt < 2 && !extracted; attempt++)
            {
                progress = $"{pack}を{(attempt == 0 ? "取得" : "再取得")}中です…";
                var download = System.Diagnostics.Stopwatch.StartNew();
                var cacheLookup = System.Diagnostics.Stopwatch.StartNew();
                PackageCacheOpenResult opened = await packageCacheModule.InvokeAsync<PackageCacheOpenResult>("openPack", "shin-era-tensei-p", manifest.Version, pack, identity, Navigation.ToAbsoluteUri("p1b-data/" + pack).AbsoluteUri, attempt != 0);
                AddStartupDuration("packageCacheLookup", cacheLookup.ElapsedMilliseconds);
                try
                {
                    IJSStreamReference streamReference = await packageCacheModule.InvokeAsync<IJSStreamReference>("openPackStream", opened.Token);
                    await using Stream input = await streamReference.OpenReadStreamAsync(manifest.TotalSize + 64L * 1024 * 1024);
                    await using (FileStream output = File.Create(archivePath))
                        await input.CopyToAsync(output);
                    downloadMilliseconds += download.ElapsedMilliseconds;
                    AddStartupDuration("cachedZipReadAndRuntimeTempWrite", download.ElapsedMilliseconds);
                    if (opened.CacheHit) packageCacheHits++;
                    else
                    {
                        packageCacheMisses++;
                        httpRequests++;
                        transferBytes += Math.Max(0, opened.ByteLength);
                    }
                    if (!opened.Persisted)
                    {
                        packageCachePersistent = false;
                        packageCacheState = "degraded: " + opened.CacheError;
                    }

                    progress = $"{pack}を展開中です…";
                    var extract = System.Diagnostics.Stopwatch.StartNew();
                    await using FileStream archive = File.OpenRead(archivePath);
                    var diagnostics = dataPrepBreakdownEnabled ? new DataPackageExtractionDiagnostics() : null;
                    DataPackageExtractionResult result = await DataPackageExtractor.ExtractPackAsync(archive, pack, root, packageIndex, manifest.TotalSize, extractedBytes, diagnostics: diagnostics);
                    if (diagnostics is not null) dataPrepPackBreakdown!.Add(new { pack, diagnostics });
                    extractedBytes += result.BytesWritten;
                    packageLookups += result.LookupCount;
                    extractMilliseconds += extract.ElapsedMilliseconds;
                    AddStartupDuration("zipExtractShaValidateAndRuntimeFsPopulate", extract.ElapsedMilliseconds);
                    extracted = true;
                }
                catch when (opened.CacheHit && attempt == 0)
                {
                    packageCacheRecoveredPacks++;
                    await packageCacheModule.InvokeVoidAsync("invalidatePack", "shin-era-tensei-p", manifest.Version, pack, identity);
                }
                finally
                {
                    var cleanupTimer = warmStartupProfile ? System.Diagnostics.Stopwatch.StartNew() : null;
                    if (File.Exists(archivePath)) File.Delete(archivePath);
                    if (cleanupTimer is not null) AddStartupDuration("runtimeTempZipCleanup", cleanupTimer.ElapsedMilliseconds);
                }
            }
            if (!extracted)
                throw new InvalidDataException($"packageを展開できません: {pack}");
        }
        if (extractedBytes != manifest.TotalSize || packageLookups != manifest.Files.Count)
            throw new InvalidDataException($"展開結果がmanifestと一致しません: bytes={extractedBytes}, lookups={packageLookups}");
        var cacheReconcile = System.Diagnostics.Stopwatch.StartNew();
        PackageCacheReconcileResult reconciled = await packageCacheModule.InvokeAsync<PackageCacheReconcileResult>("reconcile", "shin-era-tensei-p", manifest.Version,
            manifest.Files.Select(file => file.Pack).Distinct(StringComparer.Ordinal).Select(pack => new { pack, identity = PackageIdentity(manifest, pack) }).ToArray());
        AddStartupDuration("packageCacheReconcile", cacheReconcile.ElapsedMilliseconds);
        packageCacheCleanedPacks = reconciled.Removed;
        packageCacheUsage = reconciled.Usage;
        packageCacheQuota = reconciled.Quota;
        if (packageCachePersistent) packageCacheState = reconciled.Persisted ? "ready-protected" : "ready";
        if (startupImportProfileEnabled) dataPreparationAllocatedBytes = GC.GetTotalAllocatedBytes() - allocationStart;
    }

    static string PackageIdentity(DataPackageManifest manifest, string pack)
    {
        var bytes = new StringBuilder();
        foreach (DataPackageFile file in manifest.Files.Where(file => file.Pack == pack).OrderBy(file => file.Path, StringComparer.Ordinal))
            bytes.Append(file.Path).Append('\n').Append(file.Size).Append('\n').Append(file.Sha256.ToUpperInvariant()).Append('\n');
        return Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(Encoding.UTF8.GetBytes(bytes.ToString()))).ToLowerInvariant();
    }

    static string FixtureKey(string query)
    {
        foreach (string pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
            if (pair.StartsWith("fixture=", StringComparison.Ordinal))
                return Uri.UnescapeDataString(pair[8..]) switch
                {
                    "tinput" => "tinput",
                    "main" => "main",
                    "saveglobal" => "saveglobal",
                    "error" => "error",
                    "r2" => "r2",
                    "p1b" => "p1b",
                    "p1c1" => "p1c1",
                    "p1c1-real" => "p1c1-real",
                    "p1c2-real" => "p1c2-real",
                    "p1c2-host" => "p1c2-host",
                    "p1c3-real" => "p1c3-real",
                    "p1c3-r1" => "p1c3-r1",
                    "p1c4-twait" => "p1c4-twait",
                    "p1c5-skip" => "p1c5-skip",
                    "p1c6-macro" => "p1c6-macro",
                    _ => "main"
                };
        return "p1c3-real";
    }

    static string? QueryValue(string query, string key)
    {
        foreach (string pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            int equals = pair.IndexOf('=');
            string name = equals < 0 ? pair : pair[..equals];
            if (string.Equals(Uri.UnescapeDataString(name), key, StringComparison.Ordinal))
                return equals < 0 ? string.Empty : Uri.UnescapeDataString(pair[(equals + 1)..]);
        }
        return null;
    }

    public async ValueTask DisposeAsync()
    {
        awaitTimer?.Cancel();
        awaitTimer?.Dispose();
        session?.CancelAwait();
        if (scaleFitModule is not null)
        {
            try { await scaleFitModule.InvokeVoidAsync("detach"); await scaleFitModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        primitiveTimer?.Cancel();
        primitiveTimer?.Dispose();
        animationTimer?.Cancel();
        animationTimer?.Dispose();
        if (tooltipAttached && tooltipModule is not null)
            try { await tooltipModule.InvokeVoidAsync("detach", "game-surface"); } catch (JSDisconnectedException) { }
        if (tooltipModule is not null)
            try { await tooltipModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        if (timedInputDisplayModule is not null)
        {
            try { await timedInputDisplayModule.InvokeVoidAsync("stop"); } catch (JSDisconnectedException) { }
            try { await timedInputDisplayModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        if (displayWindowAttached && displayWindowModule is not null)
            try { await displayWindowModule.InvokeVoidAsync("detach", "game-screen"); } catch (JSDisconnectedException) { }
        if (keyMacroModule is not null)
        {
            try { await keyMacroModule.InvokeVoidAsync("detach"); await keyMacroModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        displayWindowReference?.Dispose();
        if (displayWindowModule is not null)
            try { await displayWindowModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        if (storeModule is not null && storeHandle is not null)
            try { await storeModule.InvokeAsync<bool>("release", storeHandle); } catch (JSDisconnectedException) { }
        if (storeModule is not null)
            try { await storeModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        longRunningModule?.Dispose();
    }

