    async Task ApplyKeyMacro(string action, int index, string? capturedText = null)
    {
        if (!CanUseKeyMacros || action != "group" && !CanRecallKeyMacros) return;
        if (action == "group") keyMacros.SelectGroup(index);
        else if (action == "register")
        {
            if (!keyMacros.Register(index, capturedText ?? input)) { keyMacroMessage = "空欄は登録しません（既存スロットは維持）"; return; }
        }
        else if (action == "recall")
        {
            string before = capturedText ?? input;
            input = keyMacros.Get(index);
            // Native TextChanged submits only when nonempty text grew at ONEINPUT/AnyKey.
            if (!macroActive && session?.Status == BrowserRuntimeStatus.WaitingForInput
                && BrowserKeyMacros.SubmitOnRecall(before, input, session.PendingInput))
            {
                input = BrowserKeyMacros.RecallInput(before, input, session.PendingInput!);
                await SubmitP1C2Text();
            }
            else
            {
                StateHasChanged();
                if (session?.PendingInput?.Kind is BrowserInputKind.String or BrowserInputKind.Integer)
                {
                    await CloseKeyMacroPanel();
                    if (keyMacroModule is not null) await keyMacroModule.InvokeVoidAsync("focusInput");
                }
            }
            return;
        }
        else return;
        try { keyMacroMessage = await storeModule!.InvokeAsync<string>("saveKeyMacros", storeHandle, keyMacros.Group, keyMacros.Slots, keyMacros.GroupNames); }
        catch (Exception ex) { keyMacroMessage = "未保存: このページ内では使用できます。" + ex.Message; }
    }
    async Task PreviewMacroFile(InputFileChangeEventArgs args)
    {
        if (!CanTransferMacroFile) return;
        macroFilePreview = null; macroFileBusy = true;
        try
        {
            await using var source = args.File.OpenReadStream(BrowserMacroFile.MaxBytes);
            using var bytes = new MemoryStream(); await source.CopyToAsync(bytes);
            macroFilePreview = BrowserMacroFile.Decode(bytes.ToArray());
            keyMacroMessage = "検証済み。内容を確認してください。まだ登録内容は変更していません。";
        }
        catch (Exception ex) { keyMacroMessage = "読み込みを中止しました。既存の登録は維持しています。" + ex.Message; }
        finally { macroFileBusy = false; }
    }
    string MacroPreviewText()
    {
        if (macroFilePreview is not { } value) return string.Empty;
        var text = new System.Text.StringBuilder();
        for (int g = 0; g < 10; g++)
        {
            text.AppendLine($"グループ{g}: {value.GroupNames[g]}");
            for (int f = 0; f < 12; f++) text.AppendLine($"  F{f + 1}: {(value.Slots[g * 12 + f].Length == 0 ? "（空）" : value.Slots[g * 12 + f])}");
        }
        return text.ToString();
    }
    void CancelMacroFile() { macroFilePreview = null; keyMacroMessage = "キャンセルしました。既存の登録は維持しています。"; }
    sealed class MacroSaveResult { public bool Saved { get; set; } public string Message { get; set; } = string.Empty; }
    async Task ConfirmMacroFile()
    {
        if (!CanTransferMacroFile || macroFilePreview is not { } value) return;
        macroFileBusy = true;
        try
        {
            if (!await JS.InvokeAsync<bool>("confirm", "現在の全10グループ・120スロットを読み込み内容に置き換えます。未指定スロットは空になります。よろしいですか？")) return;
            // Persist before applying: a failed atomic localStorage write leaves the old bank intact.
            var result = await storeModule!.InvokeAsync<MacroSaveResult>("replaceKeyMacros", storeHandle, keyMacros.Group, value.Slots, value.GroupNames);
            if (!result.Saved) { keyMacroMessage = result.Message + " 既存の登録は維持しています。"; return; }
            keyMacros.Restore(keyMacros.Group, value.Slots, value.GroupNames);
            macroFilePreview = null; keyMacroMessage = "全体置換とブラウザ内保存が完了しました（マクロは実行していません）。";
        }
        catch (Exception ex) { keyMacroMessage = "このページの登録は変更していません。保存結果を確認できなかったため、再読込後の内容を確認してください。" + ex.Message; }
        finally { macroFileBusy = false; }
    }
    async Task ExportMacroFile()
    {
        if (!CanTransferMacroFile) return;
        try
        {
            var bytes = BrowserMacroFile.Encode(keyMacros.GroupNames, keyMacros.Slots);
            await keyMacroModule!.InvokeVoidAsync("downloadMacro", bytes);
            keyMacroMessage = "CP932のmacro.txtダウンロードを開始しました。全10グループ・120スロットを含みます。";
        }
        catch (Exception ex) { keyMacroMessage = "書き出しを中止しました。" + ex.Message; }
    }
    [JSInvokable]
    public async Task DispatchHostKey(string code, string key, bool ctrl, bool shift, bool alt, bool meta, bool repeat,
        string action, int index, string text, long requestId, long generation, long token)
    {
        if (keyMacroModule is null || !await keyMacroModule.InvokeAsync<bool>("current", token)
            || session is null || session.SessionGeneration != generation || (session.PendingInput?.RequestId ?? 0) != requestId
            || keyboardTransition || importInProgress || macroFileBusy) return;
        if (action == "game") await SubmitPrimitiveKey(new KeyboardEventArgs { Code = code, Key = key, CtrlKey = ctrl, ShiftKey = shift, AltKey = alt, MetaKey = meta, Repeat = repeat });
        else if (!repeat) await ApplyKeyMacro(action, index, text);
        await InvokeAsync(StateHasChanged);
    }
