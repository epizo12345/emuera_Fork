    async Task SubmitGameAreaClick(MouseEventArgs mouse, string elementId)
    {
        if (mouse.Button != 0 || storeModule is null) return;
        GameAreaClickContext? click = await storeModule.InvokeAsync<GameAreaClickContext?>("consumeGameAreaClick", elementId);
        BrowserRuntimeSession? activeSession = session;
        if (click is null || !dataReady || activeSession?.PendingInput is not { Kind: BrowserInputKind.Enter or BrowserInputKind.AnyKey } prompt
            || prompt.RequestId != click.RequestId
            || activeSession.SessionGeneration != click.SessionGeneration) return;
        // Animation/display redraws can change DisplayGeneration while this same WAIT is still active.
        var envelope = new InputEnvelope(click.RequestId, string.Empty, BrowserInputSource.Keyboard,
            click.SessionGeneration, activeSession.DisplayGeneration);
        if (!activeSession.Submit(envelope)) return;
        input = string.Empty;
        SetDiagnosticStage("text-input");
        await AdvanceP1C2();
    }

    async Task SubmitPrimitivePointer(MouseEventArgs mouse)
    {
        BrowserRuntimeSession? activeSession = session;
        if (!dataReady || activeSession?.PendingInput is not { } prompt) return;
        if (mouse.Button == 2 && prompt is { Kind: BrowserInputKind.Enter or BrowserInputKind.AnyKey, StopMessageSkip: false })
        {
            await SubmitP1C2TextCore(startMessageSkip: true, forceEmpty: true);
            return;
        }
        if (prompt.Kind != BrowserInputKind.MouseKey) return;
        PointerContext pointer = await ReadPointerContext(mouse.ClientX, mouse.ClientY);
        if (!activeSession.SubmitPrimitive(new(prompt.RequestId, BrowserPrimitiveInputKind.Click,
            ButtonValue: pointer.ButtonValue, Code: MouseCode(mouse.Button), X: pointer.X, Y: pointer.Y,
            ButtonIsInteger: pointer.ButtonIsInteger,
            SessionGeneration: activeSession.SessionGeneration, DisplayGeneration: activeSession.DisplayGeneration))) return;
        SetDiagnosticStage("mousekey-click");
        await AdvanceP1C2();
    }

    static int MouseCode(long button) => button switch { 0 => 1048576, 1 => 4194304, 2 => 2097152, _ => 0 };

    int? DisplayDiagnosticCount(BrowserDisplayPartKind kind)
    {
        if (!perfGate01b) return null;
        if (session is null) return 0;
        if (diagnosticCountGeneration != session.DisplayStructureGeneration || diagnosticCountSession != session.SessionGeneration)
        {
            long started = System.Diagnostics.Stopwatch.GetTimestamp();
            diagnosticImages = diagnosticButtons = 0;
            foreach (BrowserDisplayPart part in FlattenDisplay(session.DisplayLines.SelectMany(line => line.Parts)))
            {
                if (part.Kind == BrowserDisplayPartKind.Image) diagnosticImages++;
                if (part.Kind == BrowserDisplayPartKind.Button) diagnosticButtons++;
            }
            diagnosticCountGeneration = session.DisplayStructureGeneration;
            diagnosticCountSession = session.SessionGeneration;
            hiddenCountCalls++;
            hiddenCountElapsedTicks += System.Diagnostics.Stopwatch.GetElapsedTime(started).Ticks;
        }
        return kind == BrowserDisplayPartKind.Image ? diagnosticImages : diagnosticButtons;
    }

    static IEnumerable<BrowserDisplayPart> FlattenDisplay(IEnumerable<BrowserDisplayPart> parts)
    {
        foreach (BrowserDisplayPart part in parts)
        {
            yield return part;
            if (part.Children is not null)
                foreach (BrowserDisplayPart child in FlattenDisplay(part.Children))
                    yield return child;
        }
    }

