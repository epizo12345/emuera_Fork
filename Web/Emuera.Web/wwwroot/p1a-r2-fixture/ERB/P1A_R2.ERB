@SYSTEM_TITLE
; StartupTestのログ通知を比較範囲の前へ出すためのウォームアップ
WAIT
PRINTL R2_BEGIN
R2_A0 = LINECOUNT
PRINTL A_BEFORE
R2_A1 = LINECOUNT
WAIT
R2_A2 = LINECOUNT
PRINTL A_AFTER
R2_A3 = LINECOUNT
WAIT
WAIT
R2_A4 = LINECOUNT

R2_B0 = LINECOUNT
PRINTL B_BEFORE
DRAWLINE
PRINTL B_AFTER
PRINTL
PRINTL B_END
R2_B1 = LINECOUNT
DRAWLINEFORM =
CUSTOMDRAWLINE +
R2_B2 = LINECOUNT

R2_C0 = LINECOUNT
PRINT C_PROMPT:
INPUTS
R2_C1 = LINECOUNT
PRINTFORM [%RESULTS%]
PRINTL C_END
R2_C2 = LINECOUNT

R2_D0 = LINECOUNT
PRINT D_A
PRINT D_B
PRINTL D_C
R2_D1 = LINECOUNT
PRINTN D_N:
R2_D2 = LINECOUNT
PRINTL D_AFTER_N
R2_D3 = LINECOUNT
PRINTL D_DEFAULT_INT
INPUT 42
PRINTFORML D_INT={RESULT}
PRINTL D_EMPTY_STR
INPUTS
PRINTFORML D_EMPTY=[%RESULTS%]
PRINTL D_JAPANESE
INPUTS
PRINTFORML D_JP=[%RESULTS%]
R2_D4 = LINECOUNT

PRINTFORML LC_A={R2_A1 - R2_A0},{R2_A2 - R2_A1},{R2_A3 - R2_A2},{R2_A4 - R2_A3}
PRINTFORML LC_B={R2_B1 - R2_B0},{R2_B2 - R2_B1}
PRINTFORML LC_C={R2_C1 - R2_C0},{R2_C2 - R2_C1}
PRINTFORML LC_D={R2_D1 - R2_D0},{R2_D2 - R2_D1},{R2_D3 - R2_D2},{R2_D4 - R2_D3}
PRINTL R2_END
PRINT D_QUIT
QUIT
