<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <EnableErbExecutionProfiler Condition="'$(EnableErbExecutionProfiler)' == ''">false</EnableErbExecutionProfiler>
    <DefineConstants Condition="'$(EnableErbExecutionProfiler)' == 'true'">$(DefineConstants);ERB_EXECUTION_PROFILE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Emuera.Web.Runtime\Emuera.Web.Runtime.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="reports/**/*.cs" />
  </ItemGroup>
</Project>
