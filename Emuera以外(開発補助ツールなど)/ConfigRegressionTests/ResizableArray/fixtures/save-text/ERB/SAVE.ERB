@SYSTEM_TITLE
RESIZE SV_INT, 3
SV_INT:2 = 4
CALL REF_RESET, SV_INT
SIF RESULT != 1
	CALL NG, "RESETDATA keeps REF RESIZABLE target"
SV_INT:4 = 44
SV_INT:1 = 11
SV_STR:2 '= "c"
GV_INT:2 = 22
SV_FIXED:1 = 5
SV_TAIL:0 = 3
SV_TAIL:5 = 0
SV_STAIL:3 '= ""
RESIZE SV_EMPTY, 0
GV_TAIL:6 = 0
SAVEGLOBAL
SAVEDATA 0, "resizable"
RESIZE GV_INT, 9
GV_INT:8 = 1
RESIZE GV_TAIL, 0
LOADGLOBAL
SIF ARRAYSIZE(GV_INT) != 3 || GV_INT:2 != 22 || GV_INT:0 != 0
	CALL NG, "global"
SIF ARRAYSIZE(GV_TAIL) != 7
	CALL NG, "global trailing zero keeps length"
RESIZE SV_INT, 0
RESIZE SV_STR, 7
RESIZE SV_TAIL, 0
RESIZE SV_STAIL, 0
SV_EMPTY:9 = 1
LOADDATA 0
PRINTL SAVE_SHOULD_NOT_REACH
WAIT
QUIT

@EVENTLOAD
SIF ARRAYSIZE(SV_INT) != 5 || SV_INT:4 != 44 || SV_INT:1 != 11 || SV_INT:0 != 0
	CALL NG, "int"
SIF ARRAYSIZE(SV_STR) != 3 || SV_STR:2 != "c" || SV_STR:0 != ""
	CALL NG, "str"
SIF SV_FIXED:1 != 5
	CALL NG, "fixed"
SIF ARRAYSIZE(SV_TAIL) != 6 || SV_TAIL:0 != 3 || SV_TAIL:5 != 0
	CALL NG, "trailing zero keeps length"
SIF ARRAYSIZE(SV_STAIL) != 4 || SV_STAIL:3 != ""
	CALL NG, "trailing empty string keeps length"
SIF ARRAYSIZE(SV_EMPTY) != 0
	CALL NG, "length 0 is saved"
PRINTFORML SAVE_DONE fail={CHK_FAIL}
SIF CHK_FAIL == 0
	PRINTL SAVE_ALL_PASS
WAIT
QUIT

@REF_RESET, RR_ARR
#DIM REF RESIZABLE RR_ARR
RESETDATA
RR_ARR:1 = 6
RETURN ARRAYSIZE(SV_INT) == 2 && SV_INT:1 == 6 && SV_INT:0 == 0

@NG, NG_NAME
#DIMS NG_NAME
CHK_FAIL += 1
PRINTFORML SAVE_FAIL %NG_NAME%
