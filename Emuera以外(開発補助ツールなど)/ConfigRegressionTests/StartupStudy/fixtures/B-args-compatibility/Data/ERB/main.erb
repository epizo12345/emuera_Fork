@SYSTEM_TITLE
	CALL COMPAT_CALLER, 123, "CALLER_TEXT"
	IF RESULT == 1
		PRINTL B_ARG_ARGS_COMPAT_ALL_PASS
	ELSE
		PRINTL B_COMPAT_BAD
	ENDIF
	OUTPUTLOG
	INPUT
	QUIT
@COMPAT_CALLER, ARG:1100, ARGS:1100
	ARG@NO_ARGUMENT_OWNER:1100 = 789
	ARGS@NO_ARGUMENT_OWNER:1100 = EXISTING_TEXT
	IF ARG@NO_ARGUMENT_OWNER:1100 != 789 || ARGS@NO_ARGUMENT_OWNER:1100 != "EXISTING_TEXT"
		RETURN 0
	ENDIF
	PRINTL B_NO_DECLARATION_ARG_ARGS_PASS
	CALL DECLARED_OWNER, 456, "DECLARED_TEXT"
	IF ARG@DECLARED_OWNER:1100 != 456 || ARGS@DECLARED_OWNER:1100 != "DECLARED_TEXT"
		RETURN 0
	ENDIF
	PRINTL B_DECLARED_ARG_ARGS_PASS
	RETURN 1
@NO_ARGUMENT_OWNER
	RETURN
@DECLARED_OWNER, ARG:1100, ARGS:1100
	RETURN
