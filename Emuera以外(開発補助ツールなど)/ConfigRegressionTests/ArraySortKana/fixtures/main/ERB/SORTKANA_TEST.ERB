; ARRAYSORTKANAの動作確認。失敗はSORTKANA_FAILを表示し、最後に件数を表示する。
@SYSTEM_TITLE
;---- かな: 50音順、ひらがな/カタカナ・全角/半角は同順位で序数順に固定 ----
KS:0 '= "ワ", "さくら", "アイ", "あい", "ｶﾞ", "か", "が", "ん", "ぱ", "は", "ば"
ARRAYSORTKANA KS, FORWARD, 0, 11
CALL CHK, "kana forward", JOINS(0, 11) == "あい,アイ,か,が,ｶﾞ,さくら,は,ば,ぱ,ワ,ん"
ARRAYSORTKANA KS, BACK, 0, 11
CALL CHK, "kana back", JOINS(0, 11) == "ん,ワ,ぱ,ば,は,さくら,ｶﾞ,が,か,アイ,あい"
;---- 範囲指定: 範囲外は動かない ----
KS:0 '= "う", "え", "い", "あ", "お"
ARRAYSORTKANA KS, FORWARD, 1, 3
CALL CHK, "range only", JOINS(0, 5) == "う,あ,い,え,お"
;---- 漢字: JIS第1水準の音読み順 ----
KS:0 '= "鈴木", "安藤", "佐藤", "伊藤"
ARRAYSORTKANA KS, FORWARD, 0, 4
CALL CHK, "kanji JIS order", JOINS(0, 4) == "安藤,伊藤,佐藤,鈴木"
;---- かなは漢字より前、空文字は先頭 ----
KS:0 '= "鈴木", "すずき", ""
ARRAYSORTKANA KS, FORWARD, 0, 3
CALL CHK, "empty first, kana before kanji", JOINS(0, 3) == ",すずき,鈴木"
;---- 引数省略: 配列全体 ----
VARSET KS, "ん"
KS:5 '= "あ"
ARRAYSORTKANA KS
CALL CHK, "whole array", KS:0 == "あ" && KS:1 == "ん" && KS:19 == "ん"
;---- 整数配列はARRAYSORTと同じ ----
KN:0 = 3, -1, 2
ARRAYSORTKANA KN, FORWARD, 0, 3
CALL CHK, "integer", KN:0 == -1 && KN:1 == 2 && KN:2 == 3
;---- 既存ARRAYSORTは変わらない（漢字はコード順） ----
KS:0 '= "鈴木", "安藤", "伊藤"
ARRAYSORT KS, FORWARD, 0, 3
CALL CHK, "ARRAYSORT unchanged", JOINS(0, 3) == "伊藤,安藤,鈴木"
;---- RESIZABLE: 今の長さだけを並べる（容量の空きが混ざらない） ----
KR:0 '= "ん", "か", "あ"
ARRAYSORTKANA KR
CALL CHK, "resizable", ARRAYSIZE(KR) == 3 && KR:0 == "あ" && KR:1 == "か" && KR:2 == "ん"
;---- 結果 ----
PRINTFORML SORTKANA_DONE pass={CHK_PASS} fail={CHK_FAIL}
SIF CHK_FAIL == 0
	PRINTL SORTKANA_ALL_PASS
WAIT
QUIT

@CHK, CK_NAME, CK_OK
#DIMS CK_NAME
#DIM CK_OK
IF CK_OK
	CHK_PASS += 1
ELSE
	CHK_FAIL += 1
	PRINTFORML SORTKANA_FAIL %CK_NAME% [%JOINS(0, 11)%]
ENDIF

@JOINS(J_START, J_COUNT)
#FUNCTIONS
#DIM J_START
#DIM J_COUNT
#DIMS J_OUT
#DIM J_I
J_OUT = %KS:J_START%
FOR J_I, J_START + 1, J_START + J_COUNT
	J_OUT = %J_OUT%,%KS:J_I%
NEXT
RETURNF J_OUT
