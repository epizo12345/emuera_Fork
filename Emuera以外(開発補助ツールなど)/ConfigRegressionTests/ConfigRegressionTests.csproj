<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Emuera.ConfigRegressionTests</AssemblyName>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- A〜D固有試験は別のentry pointで実行し、通常の回帰試験へ混在させない。 -->
    <Compile Remove="StartupStudy\**\*.cs" />
    <!-- 終了寿命のWindows UI試験は別hostで実行する。 -->
    <Compile Remove="ShutdownStudy\**\*.cs" />
    <ProjectReference Include="..\..\Emuera.csproj" />
  </ItemGroup>
</Project>
