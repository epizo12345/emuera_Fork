;---------------------------------------------------------------------------------------------------------------------------------
;イベント「開発時テスト」に使用する各種グローバス変数・定数
;---------------------------------------------------------------------------------------------------------------------------------
;更新日時       更新者                  更新内容
;2024/12/08     ロッド@カヤノソト	    ファイルを新規作成
;---------------------------------------------------------------------------------------------------------------------------------
;Emueraの開発時などにデバッグテストなどで使用するイベントです。eraMegaten本編には使用しません。
;---------------------------------------------------------------------------------------------------------------------------------

;----------------------------------
;定数宣言
;----------------------------------
;一度の周回あたりに解凍可能な数　※50日が経過した場合、回数無制限となる
;#DIM CONST EVENT125_CONST_MAX_THAW_CNT = 3
;冬眠ファイルの形式
;#DIM CONST EVENT125_CONST_FILE_TYPE_NORMAL = 1      ;通常の冬眠
;#DIM CONST EVENT125_CONST_FILE_TYPE_GROUP = 2       ;まとめて1ファイルに冬眠　※冬眠時と同セーブデータ・同周回の場合のみ解凍可能


;----------------------------------
;変数宣言
;----------------------------------
;解凍可能な残りのキャラクタ数
;#DIM SAVEDATA EVENT125_ZAN_THAW_CNT

;セーブデータのID
;#DIM SAVEDATA EVENT125_SAVEDATE_ID = 0

;セーブデータの現周回ID
;#DIM SAVEDATA EVENT125_SAVEDATE_ORBITING_ID = 0

;冬眠データのメモ情報(基本)を取得・格納する配列
;0：冬眠ファイルの形式(通常の冬眠の他にも闘技場に登場させるPTデータなどを想定)
;1：冬眠ファイル内のキャラクタ数
;2：冬眠ファイル作成時のゲームバージョン　※古いバージョンで作成した冬眠ファイルを解凍する場合は警告を行う
;3：冬眠時のセーブデータのユニークID　※セーブデータ自体と周回でそれぞれIDを付ける
;4：冬眠時のセーブデータの現周回のユニークID　※セーブデータ自体と周回でそれぞれIDを付ける
;#DIM EVENT125_ARRAY_FILE_MEMO, 5

;冬眠データのメモ情報(キャラごとの詳細)を取得・格納する配列　※同じファイルに複数のキャラクタデータが格納されることを想定
;要素1：ファイル内の冬眠キャラを指定する(最大200体まで)
;要素2：0：冬眠キャラのCSV番号 / 1：冬眠キャラのユニークID / 2:セーブデータ内でのキャラクタ番号
;#DIM EVENT125_ARRAY_FILE_MEMO_DETAIL, 200, 3

;冬眠選択画面にて選択中のキャラクタ番号のリスト
;#DIM EVENT125_ARRAY_SELECT_CHARA_NO_LIST, 200



