    <!-- [Emuera改修:BUILD-02] 修正者: epizo
         SkiaSharp.Views.WindowsForms 4.150.1には.NET 10向けの部品が用意されているが、
         Windowsの対象版を省略すると旧.NET Framework向け部品が選ばれてしまう。
         Windows 10 Version 2004（build 19041）以降を明示し、.NET 10向け部品を正しく使う。 -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- [Emuera改修:BUILD-03] 修正者: epizo
         Windows 19041を指定すると、Windows API全体をC#から使うための約24MBの部品も自動で付く。
         Emueraはその大きな部品を直接使っていないため自動追加を止める。
         SkiaSharpが必要とする小さなWinRT.Runtimeだけは、下のPackageReferenceで明示的に残す。 -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>


    <RootNamespace>MinorShift.Emuera</RootNamespace>
    <Version>0.2.6.0</Version>

    <ApplicationIcon>era_v.ico</ApplicationIcon>


    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- [Emuera改修:BUILD-01]
         大量のERBを扱うゲーム向けに、複数CPUを使えるサーバーGCを選ぶ。
         これはセーブ形式やゲーム処理を変えず、メモリ回収の方式だけを指定する。
         参照: プロジェクト資料/06_コード案内.md -->
    <ServerGarbageCollection>true</ServerGarbageCollection>

    <!-- [Emuera改修:MEASURE-01]
         性能計測は開発用ビルドで明示的に有効にしたときだけ組み込む。
         普通に配るEXEでは false のため、細かな計時処理は呼び出しごと消える。 -->
    <EnablePerformanceMetrics Condition="'$(EnablePerformanceMetrics)' == ''">false</EnablePerformanceMetrics>
    <DefineConstants Condition="'$(EnablePerformanceMetrics)' == 'true'">$(DefineConstants);PERFORMANCE_METRICS</DefineConstants>
    <!-- 0BのLegacy oracle export専用。通常Releaseには診断経路を含めない。 -->
    <EnableLegacyOracle Condition="'$(EnableLegacyOracle)' == ''">false</EnableLegacyOracle>
    <DefineConstants Condition="'$(EnableLegacyOracle)' == 'true'">$(DefineConstants);LEGACY_ORACLE</DefineConstants>
    <!-- [Emuera改修:START-04]
         起動完了時のmanaged memoryが2GiB以上の大規模構成だけ、
         Aggressive / blocking / compacting GCを1回実行する。
         2GiB未満では整理を行わず、必要ならMSBuild propertyで無効化できる。 -->
    <EnableStartupMemoryTrim Condition="'$(EnableStartupMemoryTrim)' == ''">true</EnableStartupMemoryTrim>
    <DefineConstants Condition="'$(EnableStartupMemoryTrim)' == 'true'">$(DefineConstants);STARTUP_MEMORY_TRIM</DefineConstants>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Minimum</AnalysisMode>
    
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- [Emuera改修:TOOLS-01]
         補助ツールのC#をEmuera本体へ誤って混ぜないため、コンパイル対象から外す。 -->
    <Compile Remove="Emuera以外(開発補助ツールなど)\TraceAllocationAnalyzer\**\*.cs" />
    <!-- Next RuntimeはLegacyと独立してビルドする。 -->
    <Compile Remove="NextRuntime\**\*.cs" />
    <Compile Update="Forms\ColorBox.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Forms\EraPictureBox.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="UI\Framework\FormLocalization.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>FormLocalization.resx</DependentUpon>
    </Compile>
    <Compile Update="UI\Framework\ConsoleLocalization.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ConsoleLocalization.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- Phase3D-R1: the Legacy-owned host seam implements the public NextRuntime
         contract; NextRuntime itself remains independent of Legacy. -->
    <ProjectReference Include="NextRuntime\Emuera.Next.Core\Emuera.Next.Core.csproj" />
    <ProjectReference Include="NextRuntime\Emuera.Next.Compiler\Emuera.Next.Compiler.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier" />
    <ProjectReference Include="NextRuntime\Emuera.Next.Vm\Emuera.Next.Vm.csproj" />
    <PackageReference Include="AngleSharp" Version="1.6.0" />
    <PackageReference Include="Enums.NET" Version="5.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <!-- [Emuera改修:SECURITY-01] 修正者: epizo
         Microsoft.Data.Sqliteだけでは脆弱性のあるSQLitePCLRaw 2.1.11が選ばれることがある。
         修正版の2.1.12を直接指定し、ERBからSQLを実行するときも古いSQLiteを使わせない。 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- [Emuera改修:BUILD-03] 修正者: epizo
         Windows SDK全体を外しても、SkiaSharpのOpenGL初期化にはWinRT.Runtimeが必要になる。
         従来同梱されていたものと同じ安定版2.2.0を直接参照し、必要な実行部品だけを残す。 -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile;runtime</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.150.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
    <!-- [Emuera改修:DEPENDENCY-01] 修正者: epizo
         コマンドライン解析はプレビュー版ではなく、公開済みの安定版を使用する。 -->
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="UI\Framework\FormLocalization.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>FormLocalization.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="UI\Framework\ConsoleLocalization.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ConsoleLocalization.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <!-- [Emuera改修:BUILD-03] 修正者: epizo
       Microsoft.Windows.CsWinRTのWinRT.Runtime.dllには、通常は「発行先へコピーしない」という
       印が付いている。そのままでは単一EXEにも入らないため、この小さなDLLだけ印を上書きする。
       パッケージ名とDLL名を両方確認し、別のファイルを誤って追加しないよう対象を限定している。 -->
  <Target Name="IncludeRequiredWinRTRuntimeInPublish"
          AfterTargets="ResolvePackageAssets"
          BeforeTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <RuntimeCopyLocalItems Update="@(RuntimeCopyLocalItems)"
                             Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'Microsoft.Windows.CsWinRT' and
                                        '%(RuntimeCopyLocalItems.DestinationSubPath)' == 'WinRT.Runtime.dll'">
        <CopyToPublishDirectory>true</CopyToPublishDirectory>
      </RuntimeCopyLocalItems>
    </ItemGroup>
  </Target>
</Project>
